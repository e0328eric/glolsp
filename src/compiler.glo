//! Cached compiler diagnostics, generated namespaces and checked source facts.
#import "glosso.glo";
#import "workspace.glo";
#import "model.glo";
#import "protocol.glo";
#import "positions.glo";
#import "String_Builder";
#import "Serialization/Core";
#import "Container/Hash";
#import "Container/HashSet";
#import "Container/HashMap";
#import "Strings/Utf8";
#import "Memory/Ownership";
#import "Typeclass";

#public {
    Compiler_Source :: struct { path: str; source: str; }
    // Own every input: the editor can replace buffers while this is checked.
    Compiler_Input :: struct {
        file: ssize;
        epoch: ssize;
        version: ssize;
        path: str;
        std_path: str;
        step_limit: u64;
        module_paths: [..]str;
        sources: [..]Compiler_Source;
    }
    // Only owned text crosses back from the compiler thread. Its context and
    // ABI handles are created and destroyed entirely on that thread.
    Compiler_Result :: struct {
        file: ssize;
        epoch: ssize;
        version: ssize;
        json: str;
        error: str;
        output: str;
    }
}

Compiler_Input ::: instance Freeable {
    free :: (input: *#Self_Type) {
        input.path.free(); input.std_path.free();
        for path: input.module_paths.view() path.free();
        input.module_paths.free();
        for source: input.sources.view() {
            source.path.free(); source.source.free();
        }
        input.sources.free();
    }
}
Compiler_Result ::: instance Freeable {
    free :: (completed: *#Self_Type) {
        completed.json.free(); completed.error.free(); completed.output.free();
    }
}

// libglosso breaks lines only at LF. LSP also breaks them at a lone CR, so
// such sources are positioned from the byte offset instead.
compiler_position :: (out: *String_Builder, position: ?*Json, source: str, lone_cr: bool) {
    byte := json_integer(json_field(position, "byte"), -1);
    if lone_cr && byte >= 0 && byte <= source.count {
        write_position(out, position_at(source, byte));
        return;
    }
    out.write_string("{\"line\":");
    write_json_integer(out, json_integer(json_field(position, "line"), 0));
    out.write_string(",\"character\":");
    write_json_integer(out, json_integer(json_field(position, "character"), 0));
    out.write_byte(125);
}
compiler_range :: (out: *String_Builder, range: ?*Json, source: str = "", lone_cr: bool = false) {
    out.write_string("{\"start\":");
    compiler_position(out, json_field(range, "start"), source, lone_cr);
    out.write_string(",\"end\":");
    compiler_position(out, json_field(range, "end"), source, lone_cr);
    out.write_byte(125);
}
compiler_lone_cr :: (source: str) -> bool {
    for at: 0..source.count {
        if source[at] == #char "\r" && (at + 1 >= source.count || source[at + 1] != #char "\n")
            return true;
    }
    return false;
}
compiler_failure :: (out: *String_Builder, message: str) {
    out.write_string("[{\"range\":"); compiler_range(out, null);
    out.write_string(",\"severity\":1,\"source\":\"libglosso\",\"message\":");
    write_json_string(out, message); out.write_string("}]");
}
compiler_related :: (out: *String_Builder, workspace: *const Workspace, location: ?*Json, message: str) {
    out.write_string("{\"location\":{\"uri\":");
    // Known files keep the editor's URI, including untitled buffers.
    path := json_text(json_field(location, "file"));
    file := workspace_find_path(workspace, path);
    source: str;
    uri: str;
    if file >= 0 {
        source = workspace.files[file].source;
        uri = workspace.files[file].uri.clone();
    } else uri = workspace_file_uri(workspace, path);
    defer uri.free(); write_json_string(out, uri);
    out.write_string(",\"range\":");
    compiler_range(out, json_field(location, "range"), source, compiler_lone_cr(source));
    out.write_string("},\"message\":"); write_json_string(out, message); out.write_byte(125);
}

compiler_location_file :: (workspace: *Workspace, location: ?*Json) -> ssize {
    return workspace_find_path(workspace, json_text(json_field(location, "file")));
}
compiler_location_start :: (location: ?*Json) -> ssize {
    return json_integer(json_field(json_field(json_field(location, "range"), "start"), "byte"), -1);
}
compiler_preload_location :: (workspace: *Workspace, location: ?*Json) {
    path := json_text(json_field(location, "file"));
    if path.count > 0 && !path.starts_with("<") && workspace_find_path(workspace, path) < 0
        _ = workspace_load(workspace, path);
}
compiler_symbol :: (workspace: *Workspace, location: ?*Json) -> Symbol_Id {
    file := compiler_location_file(workspace, location);
    if file < 0 return .{};
    start := compiler_location_start(location);
    for i: 0..workspace.files[file].syntax.symbols.count {
        symbol := workspace.files[file].syntax.symbols[i];
        if start >= symbol.selection_start && start < symbol.selection_end
            return .{ .file = file, .symbol = i };
    }
    return .{};
}
// Each distinct generated text has its own cache file. Reuse an entry that no
// result of the current epoch emits, so editing an #insert does not grow the
// workspace. Its old facts and edges were cleared when the epoch changed.
compiler_generated_slot :: (workspace: *Workspace, path: str, apply: ssize) -> ssize {
    uri := workspace_file_uri(workspace, path);
    defer uri.free();
    for i: 0..workspace.files.count {
        file := &workspace.files[i];
        if !file.generated || file.open || file.generated_apply == apply ||
           file.generated_epoch == workspace.compiler_epoch continue;
        workspace_clear_compiler_facts(file);
        workspace_clear_syntax(file);
        empty: str;
        file.source.free(); file.source = empty;
        file.path.free(); file.path = path.clone();
        file.uri.free(); file.uri = uri.clone();
        file.active = false;
        file.relevant = false;
        file.generated_origin = -1;
        file.generated_start = 0;
        file.generated_end = 0;
        file.generated_epoch = -1;
        for j: 0..workspace.files.count
            if workspace.files[j].generated_origin == i workspace.files[j].generated_origin = -1;
        return i;
    }
    return workspace_allocate(workspace, uri, path, false);
}
compiler_apply :: (workspace: *Workspace, root: ?*Json) {
    semantics := json_field(root, "semantics");
    workspace.compiler_applies += 1;
    apply := workspace.compiler_applies;
    if #pattern ?sources = json_array(json_field(semantics, "generated_sources")) {
        // Claim this result's existing entries before any stale one is reused.
        for i: 0..sources.*.count {
            file := workspace_find_path(workspace, json_text(json_field(?&sources.*[i], "file")));
            if file >= 0 workspace.files[file].generated_apply = apply;
        }
        for i: 0..sources.*.count {
            item: ?*Json = ?&sources.*[i];
            path := json_text(json_field(item, "file"));
            file := workspace_find_path(workspace, path);
            if file < 0 file = compiler_generated_slot(workspace, path, apply);
            if file < 0 continue;
            workspace.files[file].generated = true;
            workspace.files[file].generated_apply = apply;
            _ = workspace_replace_source(workspace, file, json_text(json_field(item, "text")));
        }
    }
    // Loading a declaration can grow the file array and invalidate input state.
    // Finish all loading before publishing borrowed symbol identities/facts.
    if #pattern ?facts = json_array(json_field(semantics, "facts")) {
        for i: 0..facts.*.count {
            item: ?*Json = ?&facts.*[i];
            compiler_preload_location(workspace, json_field(item, "definition"));
            compiler_preload_location(workspace, json_field(item, "type_definition"));
        }
    }
    if #pattern ?sources = json_array(json_field(semantics, "generated_sources")) {
        for i: 0..sources.*.count {
            item: ?*Json = ?&sources.*[i];
            file := workspace_find_path(workspace, json_text(json_field(item, "file")));
            if file < 0 continue;
            // Loading has finished, so this is the epoch the facts belong to.
            workspace.files[file].generated_epoch = workspace.compiler_epoch;
            if #pattern ?insertions = json_array(json_field(item, "insertions")) {
                if insertions.*.count == 0 continue;
                owner := compiler_location_file(workspace, ?&insertions.*[insertions.*.count - 1]);
                if owner < 0 || owner == file continue;
                site: ?*Json = ?&insertions.*[insertions.*.count - 1];
                workspace.files[file].generated_origin = owner;
                workspace.files[file].generated_start = compiler_location_start(site);
                workspace.files[file].generated_end = json_integer(json_field(
                    json_field(json_field(site, "range"), "end"), "byte"));
                seen := false;
                for other: workspace.files[owner].generated_files.view() if other == file seen = true;
                if !seen workspace.files[owner].generated_files.push(file);
            }
        }
    }
    // Visibility may have been inherited from #public around the insertion.
    // The generated text alone cannot recover that audience.
    if #pattern ?declarations = json_array(json_field(semantics, "generated_declarations")) {
        for i: 0..declarations.*.count {
            declaration: ?*Json = ?&declarations.*[i];
            symbol := compiler_symbol(workspace, json_field(declaration, "definition"));
            if symbol.symbol < 0 continue;
            target := &workspace.files[symbol.file].syntax.symbols[symbol.symbol];
            target.is_public = json_boolean(json_field(declaration, "public")) ||
                json_boolean(json_field(declaration, "unit"));
            target.is_unit = json_boolean(json_field(declaration, "unit"));
        }
    }
    if #pattern ?scopes = json_array(json_field(semantics, "scopes")) {
        for i: 0..scopes.*.count {
            scope: ?*Json = ?&scopes.*[i];
            file := workspace_find_path(workspace, json_text(json_field(scope, "file")));
            if file < 0 continue;
            if #pattern ?bindings = json_array(json_field(scope, "bindings")) {
                for j: 0..bindings.*.count {
                    binding: ?*Json = ?&bindings.*[j];
                    target := compiler_symbol(workspace, json_field(binding, "definition"));
                    if target.symbol < 0 continue;
                    name := json_text(json_field(binding, "name"));
                    if compiler_binding_known(&workspace.files[file], name, target) continue;
                    workspace.files[file].compiler_bindings.push(.{ .name = name.clone(), .target = target });
                    _ := workspace.files[file].compiler_binding_keys.insert(
                        compiler_binding_key(name, target), workspace.files[file].compiler_bindings.count - 1);
                }
            }
        }
    }
    if #pattern ?facts = json_array(json_field(semantics, "facts")) {
        for i: 0..facts.*.count {
            item: ?*Json = ?&facts.*[i];
            location := json_field(item, "location");
            file := compiler_location_file(workspace, location);
            if file < 0 continue;
            start := compiler_location_start(location);
            end := json_integer(json_field(json_field(json_field(location, "range"), "end"), "byte"), -1);
            kind: s32 = 0;
            if json_text(json_field(item, "kind")) == {
                case "binding"; kind = 1;
                case "expression"; kind = 2;
                case "call"; kind = 3;
                else; continue;
            }
            if start < 0 || end <= start || end > workspace.files[file].source.count continue;
            // Offsets are below `source_limit`, so the packed key is exact.
            key := (cast(u64)start << 32) | (cast(u64)end << 2) | cast(u64)kind;
            #pattern.Ok(added) := workspace.files[file].compiler_fact_keys.insert(key) else { continue; };
            if added workspace.files[file].compiler_facts.push(.{
                .start = start, .end = end, .kind = kind,
                .type_name = json_text(json_field(item, "type")).clone(),
                .type_definition = compiler_symbol(workspace, json_field(item, "type_definition")),
                .definition = compiler_symbol(workspace, json_field(item, "definition")),
            });
        }
    }
    for i: 0..workspace.files.count {
        if workspace.files[i].compiler_fact_order.count != workspace.files[i].compiler_facts.count
            workspace_index_compiler_facts(&workspace.files[i]);
    }
    workspace.analyzed_generation = -1;
    workspace_refresh_relevance(workspace);
}
compiler_binding_key :: (name: str, target: Symbol_Id) -> u64 {
    return name.hash() ^ (cast(u64)target.file << 32) ^ cast(u64)target.symbol;
}
// Several results bind the same generated names; find duplicates by hash.
compiler_binding_known :: (file: *Source_File, name: str, target: Symbol_Id) -> bool {
    if #pattern ?existing = file.compiler_binding_keys.get_ref(compiler_binding_key(name, target)) {
        other := file.compiler_bindings[existing.*];
        if other.name == name && other.target.file == target.file &&
           other.target.symbol == target.symbol return true;
        // A hash collision: fall back to comparing every binding.
        for binding: file.compiler_bindings.view() {
            if binding.name == name && binding.target.file == target.file &&
               binding.target.symbol == target.symbol return true;
        }
    }
    return false;
}
compiler_error :: (workspace: *Workspace, file: ssize, message: str) {
    workspace.files[file].compiler_error = message.clone();
    workspace.files[file].compiler_epoch = workspace.compiler_epoch;
}
// The ABI returns arbitrary bytes. Bound each stream and replace invalid UTF-8
// before including failed compile-time output in a JSON diagnostic.
compiler_capture_output :: (out: *String_Builder, result: Glosso_Handle, stream: u32, label: str) {
    captured := glosso_text(glosso_result_output(result, stream));
    if captured.count == 0 return;
    out.write_string("\n\nCompile-time "); out.write_string(label); out.write_string(":\n");
    cursor: ssize = 0;
    limit: ssize = 16384;
    while cursor < captured.count && cursor < limit {
        if #pattern ?decoded = captured.decode_at(cursor) {
            if decoded.next > limit break;
            out.write_string(captured[cursor..decoded.next]);
            cursor = decoded.next;
        } else {
            out.write_string("�"); cursor += 1;
        }
    }
    if cursor < captured.count out.write_string("\n[output truncated]");
}
#public compiler_input :: (workspace: *const Workspace, index: ssize) -> Compiler_Input {
    input: Compiler_Input = .{
        .file = index, .epoch = workspace.compiler_epoch,
        .version = workspace.files[index].version,
        .path = workspace.files[index].path.clone(),
        .std_path = workspace.std_path.clone(),
        .step_limit = workspace.compiler_step_limit,
    };
    for path: workspace.import_paths.view() input.module_paths.push(path.clone());
    if workspace.roots_as_module_paths
        for path: workspace.roots.view() input.module_paths.push(path.clone());
    for file: workspace.files.view() {
        if file.open && !file.generated && file.path.count > 0
            input.sources.push(.{ .path = file.path.clone(), .source = file.source.clone() });
    }
    return input;
}

#public compiler_run :: (input: *const Compiler_Input) -> Compiler_Result {
    completed: Compiler_Result = .{
        .file = input.file, .epoch = input.epoch, .version = input.version,
    };
    // Buffers without a file path, such as `git:` views, are not checked.
    if input.path.count == 0 {
        completed.json = "{}".clone();
        return completed;
    }
    handle: Glosso_Handle;
    if glosso_context_create(glosso_view(input.std_path), &handle) != 0 {
        completed.error = glosso_text(glosso_last_error()).clone(); return completed;
    }
    defer glosso_context_destroy(handle);
    _ = glosso_context_set_step_limit(handle, input.step_limit);
    for path: input.module_paths.view() _ = glosso_context_add_module_path(handle, glosso_view(path));
    for file: input.sources.view() {
        if glosso_context_set_file(handle, glosso_view(file.path), glosso_view(file.source)) != 0 {
            completed.error = glosso_text(glosso_last_error()).clone(); return completed;
        }
    }
    result: Glosso_Handle;
    // All project functions are checked; imported standard bodies are checked
    // as dependencies, as in a normal compiler invocation.
    if glosso_analyze(handle, glosso_view(input.path),
        GLOSSO_PROGRAM_ROOTS | GLOSSO_NO_MAIN | GLOSSO_EXPORT_SEMANTICS, &result) != 0 {
        completed.error = glosso_text(glosso_last_error()).clone(); return completed;
    }
    defer glosso_result_destroy(result);
    completed.json = glosso_text(glosso_result_json(result)).clone();
    if glosso_result_success(result) == 0 {
        output: String_Builder;
        compiler_capture_output(&output, result, 1, "stdout");
        compiler_capture_output(&output, result, 2, "stderr");
        completed.output = output.into_string();
    }
    return completed;
}

#public compiler_accept :: (workspace: *Workspace, completed: *const Compiler_Result) -> bool {
    index := completed.file;
    if completed.epoch != workspace.compiler_epoch || index < 0 || index >= workspace.files.count ||
       !workspace.files[index].active || completed.version != workspace.files[index].version
        return false;
    if workspace.files[index].compiler_ready {
        workspace.files[index].compiler_document.destroy();
        workspace.files[index].compiler_ready = false;
    }
    workspace.files[index].compiler_error.free();
    workspace.files[index].compiler_output.free();
    empty: str;
    workspace.files[index].compiler_error = empty;
    workspace.files[index].compiler_output = empty;
    if completed.error.count > 0 {
        compiler_error(workspace, index, completed.error);
        return true;
    }
    if json_parse_document(completed.json) == {
        case .Err; compiler_error(workspace, index, "Invalid JSON from libglosso");
        case .Ok(document);
            compiler_apply(workspace, ?&document.root);
            workspace.files[index].compiler_output = completed.output.clone();
            workspace.files[index].compiler_document = document;
            workspace.files[index].compiler_ready = true;
            workspace.files[index].compiler_epoch = workspace.compiler_epoch;
    }
    return true;
}

#public compiler_refresh :: (workspace: *Workspace, index: ssize) {
    if workspace.files[index].generated ||
       workspace.files[index].compiler_epoch == workspace.compiler_epoch return;
    input := compiler_input(workspace, index);
    defer input.free();
    completed := compiler_run(&input);
    defer completed.free();
    _ = compiler_accept(workspace, &completed);
}
#public compiler_write_diagnostics :: (out: *String_Builder, workspace: *Workspace, index: ssize) {
    file := &workspace.files[index];
    if file.compiler_error.count > 0 { compiler_failure(out, file.compiler_error); return; }
    if !file.compiler_ready { out.write_string("[]"); return; }
    document := &file.compiler_document;
    lone_cr := compiler_lone_cr(file.source);
    out.write_byte(91);
    if #pattern ?diagnostics = json_array(json_field(?&document.root, "diagnostics")) {
        for i: 0..diagnostics.*.count {
            item: ?*Json = ?&diagnostics.*[i];
            location := json_field(item, "location");
            origin := json_text(json_field(location, "file"));
            range := json_field(location, "range");
            foreign_file := origin.count > 0 && origin != json_text(json_field(?&document.root, "file"));
            if i > 0 out.write_byte(44);
            out.write_string("{\"range\":");
            if foreign_file compiler_range(out, null);
            else compiler_range(out, range, file.source, lone_cr);
            out.write_string(",\"source\":\"libglosso\",\"severity\":");
            severity: ssize = 1;
            if #partial json_text(json_field(item, "severity")) == { case "warning"; severity = 2; }
            write_json_integer(out, severity);
            out.write_string(",\"message\":");
            message: String_Builder;
            defer message.free();
            message.write_string(json_text(json_field(item, "message")));
            if i == 0 message.write_string(file.compiler_output);
            write_json_string(out, message.to_string());
            out.write_string(",\"relatedInformation\":[");
            related: ssize = 0;
            if foreign_file {
                compiler_related(out, workspace, location, "Error in imported source"); related += 1;
            }
            if #pattern ?notes = json_array(json_field(item, "notes")) {
                for j: 0..notes.*.count {
                    note: ?*Json = ?&notes.*[j];
                    at := json_field(note, "location");
                    if json_text(json_field(at, "file")).count == 0 continue;
                    if related > 0 out.write_byte(44);
                    compiler_related(out, workspace, at, json_text(json_field(note, "message"))); related += 1;
                }
            }
            out.write_string("]}");
        }
    }
    out.write_byte(93);
}
