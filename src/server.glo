#import "compiler.glo";
#import "worker.glo";
//! Stdio transport, editor overlays, and requests against a semantic workspace.
#import "Io";
#import "Format";
#import "File_System/File";
#import "File_System/Types";
#import "Serialization/Json";
#import "Serialization/Core";
#import "String_Builder";
#import "Strings";
#import "Context";
#import "protocol.glo";
#import "positions.glo";
#import "model.glo";
#import "workspace.glo";
#import "analysis.glo";
#import "ide.glo";
#import "highlight.glo";
#import "layout.glo";
#import "Thread";
#import "Memory/Ownership";

#public INITIALIZE_RESULT :: #string,oneline
    \\{"capabilities":{
    \\    "positionEncoding":"utf-16",
    \\    "textDocumentSync":{"openClose":true,"change":2,"save":{"includeText":false}},
    \\    "completionProvider":{"triggerCharacters":[".","#","\"","/"," "]},
    \\    "hoverProvider":true,"definitionProvider":true,"declarationProvider":true,
    \\    "typeDefinitionProvider":true,
    \\    "referencesProvider":true,"documentHighlightProvider":true,
    \\    "documentSymbolProvider":true,"workspaceSymbolProvider":true,
    \\    "renameProvider":{"prepareProvider":true},"foldingRangeProvider":true,
    \\    "signatureHelpProvider":{"triggerCharacters":["(",","]},
    \\    "inlayHintProvider":true,"selectionRangeProvider":true,
    \\    "documentLinkProvider":{},"documentFormattingProvider":true,
    \\    "codeActionProvider":{"codeActionKinds":["quickfix"]},
    \\    "diagnosticProvider":{"interFileDependencies":true,"workspaceDiagnostics":false},
    \\    "workspace":{"workspaceFolders":{"supported":true,"changeNotifications":true}},
    \\    "semanticTokensProvider":{
    \\        "legend":{
    \\            "tokenTypes":["namespace","type","function","variable","parameter",
    \\                "property","keyword","comment","string","number","operator","macro"],
    \\            "tokenModifiers":["declaration","readonly"]
    \\        },"full":true
    \\    }
    \\},"serverInfo":{"name":"glolsp","version":"0.4.0"}}
;

#public Server :: struct {
    workspace: Workspace;
    initialized: bool;
    shutdown: bool;
    hierarchical_symbols: bool;
    folding_line_only: bool;
    scan_roots: bool;
    register_watchers: bool;
    refresh_semantic_tokens: bool;
    refresh_inlay_hints: bool;
    refresh_id: ssize;
    events: ?Channel(Server_Event);
    jobs: ?Channel(Compiler_Input);
    compiler_busy: bool;
    compiler_preferred: ssize = -1;
    pending_requests: [..]Pending_Request;
}

#public Pending_Request :: struct {
    body: str;
    id: str;
    file: ssize;
    epoch: ssize;
    cancelled: bool;
}

#public server_write_diagnostic :: (
    out: *String_Builder,
    source: str,
    diagnostic: Language_Diagnostic,
) {
    out.write_string("{\"range\":");
    write_range(out, source, diagnostic.start, diagnostic.end);
    out.write_string(",\"severity\":");
    write_json_integer(out, cast(ssize)diagnostic.severity);
    out.write_string(",\"source\":\"glolsp\",\"message\":");
    write_json_string(out, diagnostic.message);
    out.write_byte(#char "}");
}

#public server_write_diagnostics :: (out: *String_Builder, workspace: *Workspace, index: ssize) {
    compiler_write_diagnostics(out, workspace, index);
}

/// Publishes to `uri` when given; otherwise to every editor URI that has the
/// file open, so each alias of a symlinked file shows its diagnostics.
#public server_publish :: (
    server: *Server, output: *File, index: ssize, clear: bool = false, uri: str = "",
) {
    file := &server.workspace.files[index];
    if uri.count > 0 server_publish_uri(server, output, index, uri, clear);
    else if file.aliases.count == 0 server_publish_uri(server, output, index, file.uri, clear);
    else for alias: file.aliases.view() server_publish_uri(server, output, index, alias, clear);
}

server_publish_uri :: (server: *Server, output: *File, index: ssize, uri: str, clear: bool) {
    out: String_Builder;
    defer out.free();
    out.write_string("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",");
    out.write_string("\"params\":{\"uri\":");
    write_json_string(&out, uri);
    out.write_string(",\"version\":");
    write_json_integer(&out, server.workspace.files[index].version);
    out.write_string(",\"diagnostics\":");
    if clear out.write_string("[]");
    else server_write_diagnostics(&out, &server.workspace, index);
    out.write_string("}}");
    _ := rpc_send(output, out.to_string());
}

#public server_publish_open :: (server: *Server, output: *File) {
    for i: 0..server.workspace.files.count {
        if !server.workspace.files[i].open continue;
        server.workspace.files[i].diagnostics_pending = true;
        if !server.workspace.files[i].generated &&
           server.workspace.files[i].compiler_epoch != server.workspace.compiler_epoch
            server.workspace.files[i].compiler_requested = true;
    }
    server_publish_ready(server, output);
}

server_publish_ready :: (server: *Server, output: *File) {
    for i: 0..server.workspace.files.count {
        file := &server.workspace.files[i];
        if file.open && file.diagnostics_pending &&
           (file.generated || file.compiler_epoch == server.workspace.compiler_epoch) {
            file.diagnostics_pending = false;
            server_publish(server, output, i);
        }
    }
}

server_refresh_analysis :: (server: *Server, output: *File) {
    for method: .["workspace/semanticTokens/refresh", "workspace/inlayHint/refresh"] {
        if method == "workspace/semanticTokens/refresh" && !server.refresh_semantic_tokens continue;
        if method == "workspace/inlayHint/refresh" && !server.refresh_inlay_hints continue;
        server.refresh_id += 1;
        out: String_Builder;
        defer out.free();
        out.write_string("{\"jsonrpc\":\"2.0\",\"id\":\"glolsp-refresh-");
        write_json_integer(&out, server.refresh_id);
        out.write_string("\",\"method\":");
        write_json_string(&out, method);
        out.write_byte(#char "}");
        _ = rpc_send(output, out.to_string());
    }
}

server_start_analysis :: (server: *Server, output: *File) {
    if server.compiler_busy || server.shutdown return;
    index := server.compiler_preferred;
    if index < 0 || index >= server.workspace.files.count ||
       !server.workspace.files[index].compiler_requested || !server.workspace.files[index].active ||
       server.workspace.files[index].generated ||
       server.workspace.files[index].compiler_epoch == server.workspace.compiler_epoch
        index = -1;
    if index < 0 {
        for i: 0..server.workspace.files.count {
            if server.workspace.files[i].active && !server.workspace.files[i].generated &&
               server.workspace.files[i].compiler_requested &&
               server.workspace.files[i].compiler_epoch != server.workspace.compiler_epoch {
                index = i; break;
            }
        }
    }
    if index < 0 return;
    input := compiler_input(&server.workspace, index);
    epoch := input.epoch;
    version := input.version;
    #pattern ?jobs := server.jobs else { input.free(); return; };
    if #pattern.Ok = jobs.send(input) {
        server.compiler_busy = true;
    } else {
        failed: Compiler_Result = .{
            .file = index, .epoch = epoch, .version = version,
            .error = "Compiler worker is unavailable".clone(),
        };
        defer failed.free();
        _ = compiler_accept(&server.workspace, &failed);
        server.workspace.files[index].compiler_requested = false;
        server_publish_ready(server, output);
    }
}

#public server_did_open :: (server: *Server, output: *File, params: ?*Json) {
    item := json_field(params, "textDocument");
    uri := json_text(json_field(item, "uri"));
    text := json_field(item, "text");
    version := json_field(item, "version");
    if uri.count == 0 || !json_is_text(text) || !json_is_integer(version) return;
    index := workspace_open(&server.workspace, uri, json_text(text), json_integer(version));
    if index < 0 return;
    server.compiler_preferred = index;
    server_publish_open(server, output);
}

#public server_did_change :: (server: *Server, output: *File, params: ?*Json) {
    item := json_field(params, "textDocument");
    index := workspace_find(&server.workspace, json_text(json_field(item, "uri")));
    if index < 0 || !server.workspace.files[index].open return;
    version := json_field(item, "version");
    if !json_is_integer(version) || json_integer(version) <= server.workspace.files[index].version
        return;
    if #pattern ?changes = json_array(json_field(params, "contentChanges")) {
        staged := server.workspace.files[index].source.clone();
        defer staged.free();
        for i: 0..changes.*.count {
            change: ?*Json = ?&changes.*[i];
            text_value := json_field(change, "text");
            if !json_is_text(text_value) return;
            text := json_text(text_value);
            if !text.bytes().utf8_is_valid() return;
            start: ssize = 0;
            end := staged.count;
            range := json_field(change, "range");
            if #pattern ?range_pointer = range {
                start = json_offset(staged, json_field(range, "start"));
                end = json_offset(staged, json_field(range, "end"));
                if start < 0 || end < start return;
            }
            if staged.count - (end - start) + text.count > server.workspace.source_limit return;
            next: String_Builder;
            next.write_string(staged[..start]);
            next.write_string(text);
            next.write_string(staged[end..]);
            staged.free();
            staged = next.into_string();
        }
        if workspace_change(
            &server.workspace,
            index,
            staged,
            json_integer(version)
        ) {
            server.compiler_preferred = index;
            server_publish_open(server, output);
        }
    }
}

#public server_initialize_workspace :: (server: *Server, params: ?*Json) {
    options := json_field(params, "initializationOptions");
    step_limit := json_integer(json_field(options, "comptimeStepLimit"), 16777216);
    if step_limit >= 0 server.workspace.compiler_step_limit = cast(u64)step_limit;
    if json_is_text(json_field(options, "stdPath"))
        workspace_set_std_path(&server.workspace, json_text(json_field(options, "stdPath")));
    // Index open files and imports immediately. Scanning an entire checkout is
    // opt-in because synchronous discovery blocks diagnostics and editor requests.
    server.scan_roots = json_boolean(json_field(options, "scanWorkspace"), false);
    limit := json_integer(json_field(options, "maxFiles"));
    if limit > 0 server.workspace.file_limit = limit;
    // `glosso compile` searches only the standard library and module paths
    // for module names. Projects relying on their roots can opt in.
    workspace_set_roots_as_module_paths(&server.workspace,
        json_boolean(json_field(options, "rootsAsModulePaths"), false));
    if #pattern ?paths = json_array(json_field(options, "importPaths")) {
        for i: 0..paths.*.count {
            path: ?*Json = ?&paths.*[i];
            if json_is_text(path) workspace_add_import_path(&server.workspace, json_text(path));
        }
    }
    if #pattern ?folders = json_array(json_field(params, "workspaceFolders")) {
        for i: 0..folders.*.count {
            folder: ?*Json = ?&folders.*[i];
            workspace_add_root(&server.workspace, json_text(json_field(folder, "uri")));
        }
    } else if json_is_text(json_field(params, "rootUri"))
        workspace_add_root(&server.workspace, json_text(json_field(params, "rootUri")));
}

#public server_scan_roots :: (server: *Server) {
    if !server.scan_roots return;
    count := server.workspace.roots.count;
    for i: 0..count {
        uri := workspace_path_to_uri(server.workspace.roots[i]);
        defer uri.free();
        workspace_scan_root(&server.workspace, uri);
    }
}

#public server_notification :: (server: *Server, output: *File, method: str, params: ?*Json) {
    if #partial method == {
        case "initialized";
        server_scan_roots(server);
        if server.register_watchers {
            registration :: #string,oneline
                \\{"jsonrpc":"2.0","id":"glolsp-watch","method":"client/registerCapability",
                \\"params":{"registrations":[{"id":"glolsp-glo-files",
                \\"method":"workspace/didChangeWatchedFiles","registerOptions":{
                \\"watchers":[{"globPattern":"**/*.glo","kind":7}]}}]}}
            ;
            _ := rpc_send(output, registration);
        }
        case "textDocument/didOpen";
        server_did_open(server, output, params);
        case "textDocument/didChange";
        server_did_change(server, output, params);
        case "textDocument/didClose";
        item := json_field(params, "textDocument");
        uri := json_text(json_field(item, "uri"));
        index := workspace_find(&server.workspace, uri);
        if index >= 0 {
            // Another URI for the same file, such as a path through a
            // symbolic link, keeps it open; clear only the closed one.
            server_publish(server, output, index, true, uri);
            workspace_close(&server.workspace, index, uri);
            if !server.workspace.files[index].open {
                server.workspace.files[index].diagnostics_pending = false;
                server.workspace.files[index].compiler_requested = false;
            }
            server_publish_open(server, output);
        }
        case "textDocument/didSave";
        server_publish_open(server, output);
        case "$/cancelRequest";
        encoded: String_Builder;
        defer encoded.free();
        write_json_value(&encoded, json_field(params, "id"));
        for i: 0..server.pending_requests.count {
            if server.pending_requests[i].id == encoded.to_string()
                server.pending_requests[i].cancelled = true;
        }
        case "workspace/didChangeWatchedFiles";
        if #pattern ?changes = json_array(json_field(params, "changes")) {
            // Watch notifications may also name data read by compile-time code.
            // Invalidate and resolve imports once for the whole batch.
            if changes.*.count > 0 workspace_invalidate_compiler(&server.workspace);
            for i: 0..changes.*.count {
                item: ?*Json = ?&changes.*[i];
                workspace_watch_file(&server.workspace, json_text(json_field(item, "uri")));
            }
            if changes.*.count > 0 workspace_refresh_imports(&server.workspace);
            server_publish_open(server, output);
        }
        case "workspace/didChangeWorkspaceFolders";
        event := json_field(params, "event");
        if #pattern ?removed = json_array(json_field(event, "removed")) {
            for i: 0..removed.*.count {
                item: ?*Json = ?&removed.*[i];
                workspace_remove_root(&server.workspace, json_text(json_field(item, "uri")));
            }
        }
        if #pattern ?added = json_array(json_field(event, "added")) {
            for i: 0..added.*.count {
                item: ?*Json = ?&added.*[i];
                uri := json_text(json_field(item, "uri"));
                workspace_add_root(&server.workspace, uri);
                if server.scan_roots workspace_scan_root(&server.workspace, uri);
            }
        }
    }
}

#public server_write_folding :: (out: *String_Builder, document: *Source_File, line_only: bool) {
    out.write_byte(#char "[");
    count: ssize = 0;
    for i: 0..document.syntax.language.tokens.count {
        token := document.syntax.language.tokens[i];
        end := token.end;
        if token.kind != 4 {
            if token.matching <= i continue;
            end = document.syntax.language.tokens[token.matching].end;
        }
        start_position := position_at(document.source, token.start);
        end_position := position_at(document.source, end);
        if end_position.line <= start_position.line continue;
        if count > 0 out.write_byte(#char ",");
        count += 1;
        out.write_string("{\"startLine\":");
        write_json_integer(out, start_position.line);
        if !line_only {
            out.write_string(",\"startCharacter\":");
            write_json_integer(out, start_position.character);
        }
        out.write_string(",\"endLine\":");
        write_json_integer(out, end_position.line);
        if !line_only {
            out.write_string(",\"endCharacter\":");
            write_json_integer(out, end_position.character);
        }
        if token.kind == 4 out.write_string(",\"kind\":\"comment\"");
        out.write_byte(#char "}");
    }
    out.write_byte(#char "]");
}

/// Requests answered from the parse tree, tokens and import edges alone.
/// Analysis of a large document can take longer than these requests.
#public server_method_syntactic :: (method: str) -> bool {
    if method == {
        case "textDocument/foldingRange", "textDocument/formatting",
             "textDocument/documentLink", "textDocument/selectionRange",
             "textDocument/diagnostic";
        return true;
        else;
        return false;
    }
}

#public server_method_known :: (method: str) -> bool {
    if method == {
        case "workspace/symbol", "textDocument/documentSymbol", "textDocument/completion",
             "textDocument/hover", "textDocument/definition", "textDocument/declaration",
            "textDocument/typeDefinition",
            "textDocument/references", "textDocument/documentHighlight",
            "textDocument/prepareRename", "textDocument/rename", "textDocument/foldingRange",
            "textDocument/semanticTokens/full", "textDocument/signatureHelp",
            "textDocument/inlayHint", "textDocument/selectionRange", "textDocument/documentLink",
            "textDocument/formatting", "textDocument/codeAction", "textDocument/diagnostic";
        return true;
        else;
        return false;
    }
}

#public server_workspace_symbol_file :: (workspace: *Workspace, file: ssize) -> bool {
    if !workspace.files[file].active || !workspace.files[file].relevant return false;
    if workspace.files[file].open return true;
    standard := workspace.std_path;
    path := workspace.files[file].path;
    in_standard := standard.count > 0 && path.starts_with(standard) &&
        (path.count == standard.count || path[standard.count] == #char "/");
    if !in_standard return true;
    for root: workspace.roots.view() {
        if path.starts_with(root) &&
           (path.count == root.count || path[root.count] == #char "/") return true;
    }
    return false;
}

#public server_document_request :: (
    server: *Server,
    output: *File,
    id: ?*Json,
    params: ?*Json,
    method: str,
    file: ssize,
) {
    workspace := &server.workspace;
    if !workspace.files[file].generated &&
       workspace.files[file].compiler_epoch != workspace.compiler_epoch {
        workspace.files[file].compiler_requested = true;
        server.compiler_preferred = file;
    }
    if method == "textDocument/references" || method == "textDocument/rename"
        analyze_workspace(workspace);
    else if !server_method_syntactic(method) analyze_document(workspace, file);
    out: String_Builder;
    defer out.free();
    source := workspace.files[file].source;
    if method == {
        case "textDocument/documentSymbol";
        out.write_byte(#char "[");
        count: ssize = 0;
        ide_write_symbols(&out, workspace, file, "", server.hierarchical_symbols, &count);
        out.write_byte(#char "]");
        case "textDocument/foldingRange";
        server_write_folding(&out, &workspace.files[file], server.folding_line_only);
        case "textDocument/semanticTokens/full";
        write_resolved_semantic_tokens(&out, workspace, file);
        case "textDocument/documentLink";
        ide_write_links(&out, workspace, file);
        case "textDocument/diagnostic";
        out.write_string("{\"kind\":\"full\",\"items\":");
        server_write_diagnostics(&out, workspace, file);
        out.write_byte(#char "}");
        case "textDocument/formatting";
        options := json_field(params, "options");
        layout_write_edits(
            &out,
            source,
            json_integer(json_field(options, "tabSize"), 4),
            json_boolean(json_field(options, "insertSpaces"), true)
        );
        case "textDocument/inlayHint";
        range := json_field(params, "range");
        start := json_offset(source, json_field(range, "start"));
        end := json_offset(source, json_field(range, "end"));
        if start < 0 || end < start {
            _ := rpc_error(output, id, -32602, "Invalid inlay hint range.");
            return;
        }
        ide_write_inlay_hints(&out, workspace, file, start, end);
        case "textDocument/selectionRange";
        if #pattern null = json_array(json_field(params, "positions")) {
            _ := rpc_error(output, id, -32602, "Selection positions must be an array.");
            return;
        }
        out.write_byte(#char "[");
        if #pattern ?positions = json_array(json_field(params, "positions")) {
            for i: 0..positions.*.count {
                offset := json_offset(source, ?&positions.*[i]);
                if offset < 0 {
                    _ := rpc_error(output, id, -32602, "Invalid selection position.");
                    return;
                }
                if i > 0 out.write_byte(#char ",");
                ide_write_selection(&out, workspace, file, offset);
            }
        }
        out.write_byte(#char "]");
        case "textDocument/codeAction";
        range := json_field(params, "range");
        start := json_offset(source, json_field(range, "start"));
        end := json_offset(source, json_field(range, "end"));
        if start < 0 || end < start {
            _ := rpc_error(output, id, -32602, "Invalid code action range.");
            return;
        }
        ide_write_code_actions(&out, workspace, file, range);
        else;
        offset := json_offset(source, json_field(params, "position"));
        if offset < 0 {
            _ := rpc_error(output, id, -32602, "Invalid UTF-16 document position.");
            return;
        }
        symbol := analysis_symbol_at(workspace, file, offset);
        if method == {
            case "textDocument/completion";
            // triggerKind 2: typing a trigger character, not an explicit request.
            request := json_field(params, "context");
            triggered := json_integer(json_field(request, "triggerKind"), 1) == 2;
            ide_write_completion(&out, workspace, file, offset, triggered);
            case "textDocument/hover";
            ide_write_hover(&out, workspace, file, offset);
            case "textDocument/definition", "textDocument/declaration";
            target := symbol;
            if #partial method == {
                case "textDocument/declaration";
                    fact := workspace_compiler_fact(workspace, file, offset, 3);
                    if analysis_valid(workspace, fact.declaration) target = fact.declaration;
            }
            if target.file >= 0 && target.symbol >= 0 ide_write_location(&out, workspace, target);
            else out.write_string("null");
            case "textDocument/typeDefinition";
            fact := workspace_compiler_fact(workspace, file, offset);
            ty := analysis_type(workspace, symbol);
            while ty > 0 && ty < workspace.types.count &&
                  (workspace.types[ty].kind == .Pointer ||
                   workspace.types[ty].kind == .Array_Type)
                ty = workspace.types[ty].element;
            if analysis_valid(workspace, fact.type_definition)
                ide_write_location(&out, workspace, fact.type_definition);
            else if ty > 0 && ty < workspace.types.count &&
               workspace.types[ty].symbol.symbol >= 0
                ide_write_location(&out, workspace, workspace.types[ty].symbol);
            else out.write_string("null");
            case "textDocument/references", "textDocument/documentHighlight";
            local_file: ssize = -1;
            highlight := method == "textDocument/documentHighlight";
            if highlight local_file = file;
            include_declaration := highlight ||
                json_boolean(json_field(json_field(params, "context"), "includeDeclaration"));
            ide_write_references(
                &out,
                workspace,
                symbol,
                include_declaration,
                local_file,
                highlight
            );
            case "textDocument/signatureHelp";
            ide_write_signature_help(&out, workspace, file, offset);
            case "textDocument/prepareRename";
            // Rejection depends on references in every analysed file.
            analyze_workspace(workspace);
            token := analysis_token_at(workspace, file, offset);
            if symbol.symbol < 0 || token < 0 || !ide_renamed_token(workspace, file, token, symbol) ||
               ide_rename_rejection(workspace, symbol).count > 0
                out.write_string("null");
            else {
                span := workspace.files[file].syntax.language.tokens[token];
                out.write_string("{\"range\":");
                write_range(&out, source, span.start, span.end);
                out.write_string(",\"placeholder\":");
                write_json_string(
                    &out,
                    workspace.files[symbol.file].syntax.symbols[symbol.symbol].name
                );
                out.write_byte(#char "}");
            }
            case "textDocument/rename";
            {
                name := json_text(json_field(params, "newName"));
                if symbol.symbol < 0 || !language_identifier_valid(name) {
                    _ := rpc_error(output, id, -32602, "A valid declared name is required.");
                    return;
                }
                rejection := ide_rename_rejection(workspace, symbol);
                if rejection.count > 0 {
                    _ = rpc_error(output, id, -32602, rejection);
                    return;
                }
                if ide_rename_conflicts(workspace, symbol, name) {
                    _ := rpc_error(output, id, -32602, "New name conflicts with a declaration.");
                    return;
                }
                ide_write_rename(&out, workspace, symbol, name);
            }
            else;
            _ := rpc_error(output, id, -32601, "Method not found.");
            return;
        }
    }
    _ := rpc_response(output, id, out.to_string());
}

// 0: continue; 1: successful exit; 2: unsuccessful exit.
server_flush_pending :: (server: *Server, output: *File) {
    pending := value_take(&server.pending_requests);
    defer pending.free();
    for request: pending.view() {
        obsolete := request.epoch != server.workspace.compiler_epoch;
        ready := server.workspace.files[request.file].compiler_epoch == server.workspace.compiler_epoch;
        if !obsolete && !ready && !request.cancelled && !server.shutdown {
            // Keep the file scheduled: closing it clears its request flag
            // without changing the epoch when the buffer matches disk.
            server.workspace.files[request.file].compiler_requested = true;
            server.pending_requests.push(request);
            continue;
        }
        defer request.body.free();
        defer request.id.free();
        if #pattern.Ok(document) = json_parse_document(request.body) {
            defer document.destroy();
            id := json_field(?&document.root, "id");
            if request.cancelled || server.shutdown
                _ = rpc_error(output, id, -32800, "Request cancelled.");
            else if obsolete
                _ = rpc_error(output, id, -32801, "Document changed during analysis.");
            else _ = server_process(server, output, &document.root, request.body);
        }
    }
}

// `body` is the message's text; a request that waits for a snapshot keeps it.
#public server_process :: (server: *Server, output: *File, message: *Json, body: str = "") -> s32 {
    root: ?*Json = ?message;
    id := json_field(root, "id");
    method_value := json_field(root, "method");
    // Responses to server requests, such as file watcher registration, carry
    // an id and a result/error instead of a method.
    if #pattern ?response_id = id {
        if !json_is_text(method_value) {
            if #pattern ?result = json_field(root, "result") return 0;
            if #pattern ?error = json_field(root, "error") return 0;
        }
    }
    if !json_is_object(root) || json_text(json_field(root, "jsonrpc")) != "2.0" ||
        !json_is_text(method_value) {
        _ := rpc_error(output, null, -32600, "Invalid JSON-RPC request.");
        return 0;
    }
    request := false;
    if #pattern ?pointer = id {
        request = true;
        valid_id := json_is_text(id) || json_is_integer(id);
        if #partial pointer.* == {
            case .unit;
            valid_id = true;
        }
        if !valid_id {
            _ := rpc_error(output, null, -32600, "Invalid request id.");
            return 0;
        }
    }
    method := json_text(method_value);
    if method == "exit" && !request {
        if server.shutdown return 1;
        return 2;
    }
    if !server.initialized && method != "initialize" {
        if request _ := rpc_error(output, id, -32002, "Server has not been initialized.");
        return 0;
    }
    if server.shutdown {
        if request _ := rpc_error(output, id, -32600, "Server is shutting down.");
        return 0;
    }
    params := json_field(root, "params");
    if method == "initialize" {
        if !request return 0;
        if server.initialized {
            _ := rpc_error(output, id, -32600, "Server is already initialized.");
            return 0;
        }
        if !json_is_object(params) {
            _ := rpc_error(output, id, -32602, "Initialize params must be an object.");
            return 0;
        }
        server_initialize_workspace(server, params);
        server.initialized = true;
        text := json_field(json_field(params, "capabilities"), "textDocument");
        workspace_capabilities := json_field(json_field(params, "capabilities"), "workspace");
        server.refresh_semantic_tokens = json_boolean(json_field(
            json_field(workspace_capabilities, "semanticTokens"), "refreshSupport"));
        server.refresh_inlay_hints = json_boolean(json_field(
            json_field(workspace_capabilities, "inlayHint"), "refreshSupport"));
        server.register_watchers =
            json_boolean(
                json_field(
                    json_field(workspace_capabilities, "didChangeWatchedFiles"),
                    "dynamicRegistration"
                )
            );
        server.hierarchical_symbols =
            json_boolean(
                json_field(json_field(text, "documentSymbol"), "hierarchicalDocumentSymbolSupport")
            );
        server.folding_line_only =
            json_boolean(json_field(json_field(text, "foldingRange"), "lineFoldingOnly"));
        _ := rpc_response(output, id, INITIALIZE_RESULT);
        return 0;
    }
    if method == "shutdown" && request {
        server.shutdown = true;
        _ := rpc_response(output, id, "null");
        return 0;
    }
    if !request {
        server_notification(server, output, method, params);
        return 0;
    }
    if !server_method_known(method) {
        _ := rpc_error(output, id, -32601, "Method not found.");
        return 0;
    }
    if !json_is_object(params) {
        _ := rpc_error(output, id, -32602, "Params must be an object.");
        return 0;
    }
    if method == "workspace/symbol" {
        if !json_is_text(json_field(params, "query")) {
            _ := rpc_error(output, id, -32602, "A symbol query is required.");
            return 0;
        }
        analyze_workspace(&server.workspace);
        out: String_Builder;
        defer out.free();
        out.write_byte(#char "[");
        count: ssize = 0;
        for file: 0..server.workspace.files.count {
            if !server_workspace_symbol_file(&server.workspace, file) continue;
            ide_write_symbols(
                &out,
                &server.workspace,
                file,
                json_text(json_field(params, "query")),
                false,
                &count,
                500
            );
        }
        out.write_byte(#char "]");
        _ := rpc_response(output, id, out.to_string());
        return 0;
    }
    item := json_field(params, "textDocument");
    file := workspace_find(&server.workspace, json_text(json_field(item, "uri")));
    if file < 0 || !server.workspace.files[file].active {
        _ := rpc_error(output, id, -32602, "Document is unavailable.");
        return 0;
    }
    // Diagnostics and edits that rename symbols require a checked snapshot.
    // Read-only editor features can use the current error-tolerant index while
    // the compiler runs. Retain these requests without blocking other traffic.
    if (method == "textDocument/diagnostic" || method == "textDocument/rename" ||
        method == "textDocument/prepareRename") &&
       !server.workspace.files[file].generated &&
       server.workspace.files[file].compiler_epoch != server.workspace.compiler_epoch {
        // Re-encoding can fail, for example on a non-finite number, and
        // would lose the id. Keep the original text when there is one.
        text: str;
        if body.count > 0 text = body.clone();
        else {
            encoded: String_Builder;
            write_json_value(&encoded, root);
            text = encoded.into_string();
        }
        encoded_id: String_Builder;
        write_json_value(&encoded_id, id);
        server.pending_requests.push(.{
            .body = text, .id = encoded_id.into_string(),
            .file = file, .epoch = server.workspace.compiler_epoch,
        });
        server.workspace.files[file].compiler_requested = true;
        server.compiler_preferred = file;
        return 0;
    }
    server_document_request(server, output, id, params, method, file);
    return 0;
}

#public run_language_server :: () -> s32 {
    arguments := get_cmdline_args();
    for i: 1..arguments.count {
        if arguments[i] == {
            case "--help", "-h";
            print("glolsp 0.4.0 - Glosso language server\nusage: glolsp [--stdio]\n");
            return 0;
            case "--version";
            print("glolsp 0.4.0\n");
            return 0;
            case "--stdio";
            continue;
            else;
            // Clients may add their own flags, such as --clientProcessId=N.
            if arguments[i].starts_with("--") {
                rpc_report(tprint("ignoring unsupported argument {} (use --help)", arguments[i]));
                continue;
            }
            rpc_report("unsupported argument (use --help)");
            return 1;
        }
    }
    stdio := worker_private_stdio();
    output := stdio.output;
    server: Server;
    #pattern.Ok(events) := Channel(Server_Event).new() else { return 1; };
    #pattern.Ok(jobs) := Channel(Compiler_Input).new() else { events.free(); return 1; };
    server.events = ?events;
    server.jobs = ?jobs;
    // Detached workers own channel references and all their inputs. Closing
    // wakes blocked senders, and shutdown never waits for user compile-time I/O.
    defer {
        events.close();
        events.free();
        jobs.close();
        jobs.free();
        for request: server.pending_requests.view() {
            request.body.free(); request.id.free();
        }
        server.pending_requests.free();
    }
    workspace_init(&server.workspace);
    defer workspace_destroy(&server.workspace);
    if !worker_start_compiler(&events, &jobs) return 1;
    if !worker_start_input(&events, stdio.input) return 1;
    while true {
        // Request-local path conversion and formatting use temporary storage.
        // Persistent workspace data owns heap buffers or views of owned source.
        reset_temporary_storage();
        // Each event may replace source buffers; see position_cache_reset.
        position_cache_reset();
        #pattern.Ok(received) := events.recv() else { return 1; };
        #pattern ?event := received else { return 1; };
        defer event.free();
        if event == {
            case .input(frame);
                if frame.status == 2 {
                    // The stream is still aligned; the id is unknown.
                    rpc_report(tprint("skipped a {}-byte message: {}", frame.length, frame.reason));
                    if !rpc_error(&output, null, -32600, tprint("Message skipped: {}.", frame.reason))
                        return 1;
                    continue;
                }
                if frame.status <= 0 {
                    if frame.status == 0 && server.shutdown return 0;
                    if frame.status == 0 rpc_report("input ended before shutdown and exit");
                    else rpc_report(tprint("invalid LSP frame: {}; exiting", frame.reason));
                    return 1;
                }
                if !frame.body.bytes().utf8_is_valid() {
                    _ := rpc_error(&output, null, -32700, "Message is not valid UTF-8.");
                    continue;
                }
                repaired := rpc_repair_surrogates(frame.body);
                defer repaired.free();
                body := frame.body;
                if repaired.count > 0 body = repaired;
                if json_parse_document(body) == {
                    case .Err;
                        if !rpc_error(&output, null, -32700, "Invalid JSON.") return 1;
                    case .Ok(message);
                        defer message.destroy();
                        status := server_process(&server, &output, &message.root, body);
                        if status == 1 return 0;
                        if status == 2 return 1;
                }
            case .checked(completed);
                server.compiler_busy = false;
                accepted := !server.shutdown && compiler_accept(&server.workspace, &completed);
                // Generated sources may have been replaced.
                position_cache_reset();
                if accepted {
                    server.workspace.files[completed.file].compiler_requested = false;
                    // Applying facts can discover source files. That updates the
                    // index revision, but does not change any editor input.
                    for i: 0..server.pending_requests.count {
                        if server.pending_requests[i].epoch == completed.epoch
                            server.pending_requests[i].epoch = server.workspace.compiler_epoch;
                    }
                    server_publish_ready(&server, &output);
                    server_refresh_analysis(&server, &output);
                }
        }
        server_flush_pending(&server, &output);
        server_start_analysis(&server, &output);
    }
}
