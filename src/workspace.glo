//! Persistent source files, editor overlays, and the dependency graph.
#import "model.glo";
#import "syntax.glo";
#import "config.glo";
#import "File_System/File";
#import "File_System/Directory";
#import "File_System/Path";
#import "File_System/System";
#import "File_System/Walk";
#import "File_System/Types";
#import "File_System/Metadata";
#import "Process/Environment";
#import "String_Builder";
#import "Strings/Utf8";
#import "Os";
#import "Context";
#import "Memory/Ownership";
#import "Serialization/Core";
#import "Container/HashSet";
#import "Container/HashMap";
#import "Sort";
#import "Format";
#import "glosso.glo";

#public {
    Workspace_Import :: struct  {
        declaration: ssize;
        target: ssize = -1;
        ambiguous: bool;
    }

    Workspace_Path_Completions :: struct {
        paths: [..]str;
        incomplete: bool;
    }

    Compiler_Binding :: struct { name: str; target: Symbol_Id; }
    Compiler_Fact :: struct {
        start: ssize;
        end: ssize;
        kind: s32; // 1 binding, 2 expression, 3 call
        type_name: str;
        type_definition: Symbol_Id;
        definition: Symbol_Id;
        declaration: Symbol_Id; // Syntax declaration before compiler callee selection.
    }

    Source_File :: struct {
        uri: str;
        path: str;
        source: str;
        version: ssize;
        open: bool;
        // Editor URIs that currently have this file open, e.g. through a
        // symlinked directory and its target. `open` is true while any remain.
        aliases: [..]str;
        active: bool;
        relevant: bool;
        // Discovered files count toward `file_limit`; editor buffers, the
        // prelude, and generated sources do not.
        counted: bool;
        syntax: Parsed_File;
        semantic: File_Semantics;
        imports: [..]Workspace_Import;
        revision: ssize;
        generated: bool;
        generated_origin: ssize = -1;
        generated_start: ssize;
        generated_end: ssize;
        // The compiler epoch and result application that last emitted this
        // generated source. Older entries are unreferenced and reusable.
        generated_epoch: ssize = -1;
        generated_apply: ssize = -1;
        generated_files: [..]ssize;
        compiler_bindings: [..]Compiler_Binding;
        compiler_facts: [..]Compiler_Fact;
        // Lookup keys for removing duplicates from the arrays above.
        compiler_binding_keys: HashMap(u64, ssize);
        compiler_fact_keys: HashSet(u64);
        // `start << 32 | index` for every fact, sorted, and the longest fact.
        // Offset lookups binary-search this instead of scanning every fact.
        compiler_fact_order: [..]u64;
        compiler_fact_span: ssize;
        compiler_epoch: ssize = -1;
        compiler_requested: bool;
        diagnostics_pending: bool;
        compiler_ready: bool;
        compiler_document: Serialization_Document;
        compiler_error: str;
        compiler_output: str;
    }

    Workspace :: struct {
        files: [..]Source_File;
        roots: [..]str;
        // The editor's URI for each root. It differs from the resolved root
        // when the folder was opened through a symbolic link.
        root_uris: [..]str;
        import_paths: [..]str;
        std_path: str;
        prelude: ssize = -1;
        types: [..]Semantic_Type;
        unit_owners: [..]ssize;
        file_limit: ssize = 4096;
        counted_files: ssize;
        uncounted_loads: ssize;
        // Search workspace roots for module names. `glosso compile` does not,
        // so this is opt-in through `rootsAsModulePaths`.
        roots_as_module_paths: bool;
        compiler_applies: ssize;
        source_limit: ssize = 16 * 1024 * 1024;
        compiler_step_limit: u64 = 16777216;
        import_depth: ssize;
        revision: ssize;
        generation: ssize;
        analyzed_generation: ssize = -1;
        compiler_epoch: ssize;
        parse_count: ssize;
        truncated: bool;
    }
}

#public workspace_byte :: (text: str, at: ssize) -> u8 {
    if at < 0 || at >= text.count return 0;
    return text.bytes()[at];
}

#public workspace_hex :: (byte: u8) -> s32 {
    if byte == {
        case #char "0"..=#char "9"; return cast(s32)(byte - #char "0");
        case #char "a"..=#char "f"; return cast(s32)(byte - #char "a") + 10;
        case #char "A"..=#char "F"; return cast(s32)(byte - #char "A") + 10;
        else; return -1;
    }
}

#public workspace_prefix :: (text: str, prefix: str) -> bool {
    if text.count < prefix.count return false;
    return text.substring_view(0, prefix.count) == prefix;
}

#public workspace_suffix :: (text: str, suffix: str) -> bool {
    if text.count < suffix.count return false;
    return text.substring_view(text.count - suffix.count, text.count) == suffix;
}

#public workspace_drive_path :: (path: str) -> bool {
    first := workspace_byte(path, 0);
    return ((first >= #char "A" && first <= #char "Z") ||
        (first >= #char "a" && first <= #char "z")) &&
        workspace_byte(path, 1) == #char ":" &&
        (workspace_byte(path, 2) == #char "/" || workspace_byte(path, 2) == #char "\\");
}

#public workspace_windows_path :: (path: str) -> str {
    cleaned := path_clean(path, .Windows);
    defer cleaned.free();
    out: String_Builder;
    defer out.free();
    for byte: cleaned.bytes() {
        if byte == #char "\\" out.write_byte(#char "/");
        else out.write_byte(byte);
    }
    converted := out.to_string();
    if workspace_prefix(converted, "//?/UNC/") {
        unc: String_Builder;
        unc.write_string("//");
        unc.write_string(converted.substring_view(8, converted.count));
        return unc.into_string();
    }
    if workspace_prefix(converted, "//?/")
        return converted.substring_view(4, converted.count).clone();
    return converted.clone();
}

/// Produces a stable absolute path; existing files also resolve symbolic links.
#public workspace_normalize_path :: (path: str) -> str {
    // Each canonical() call uses tens of kilobytes of temporary storage, and
    // resolving imports calls this thousands of times per editor event.
    // Release that scratch space unless the result itself is temporary.
    if context.allocator.procedure == context.temp_allocator.procedure &&
       context.allocator.data == context.temp_allocator.data
        return workspace_resolve_path(path);
    mark := temp_mark();
    defer temp_rewind(mark);
    return workspace_resolve_path(path);
}

workspace_resolve_path :: (path: str) -> str {
    if path.count == 0 return "".clone();
    #if OUT.os == Target_OS.Windows {
        if canonical(path) == {
            case .Ok(value);
                defer value.free();
                return workspace_windows_path(value);
            case .Err;
        }
        if absolute(path) == {
            case .Ok(value);
                defer value.free();
                return workspace_windows_path(value);
            case .Err; return workspace_windows_path(path);
        }
    }
    if workspace_drive_path(path) || workspace_prefix(path, "\\\\") ||
       workspace_prefix(path, "//") return workspace_windows_path(path);
    if canonical(path) == {
        case .Ok(value); return value;
        case .Err;
    }
    lexical: str;
    if absolute(path) == {
        case .Ok(value);
            defer value.free();
            lexical = path_clean(value);
        case .Err; lexical = path_clean(path);
    }
    // A missing file keeps the resolved spelling of its nearest existing
    // directory, so saving or deleting it never changes its identity.
    parent := path_dirname(lexical);
    if !path_is_absolute(lexical) || parent == lexical return lexical;
    defer lexical.free();
    resolved := workspace_resolve_path(parent);
    defer resolved.free();
    return path_join(resolved, path_basename(lexical));
}

/// Decodes UTF-8 file URIs, including the authority-less `file:/path` form.
/// Invalid escapes and embedded NULs are rejected.
#public workspace_uri_to_path :: (uri: str) -> str {
    decoded, remote := workspace_uri_decode(uri);
    defer decoded.free();
    if decoded.count == 0 || remote return decoded.clone();
    if decoded.count > 3 && workspace_byte(decoded, 0) == #char "/" &&
       workspace_drive_path(decoded.substring_view(1, decoded.count))
        return workspace_normalize_path(decoded.substring_view(1, decoded.count));
    return workspace_normalize_path(decoded);
}

/// The decoded path of a file URI as the editor spelled it, without resolving
/// links. The flag reports a remote authority (`//host/...`).
workspace_uri_decode :: (uri: str) -> (str, bool) {
    at: ssize = 7;
    if !workspace_prefix(uri, "file://") {
        if !workspace_prefix(uri, "file:/") return "".clone(), false;
        at = 5;
    }
    authority_start := at;
    while at < uri.count && workspace_byte(uri, at) != #char "/" at += 1;
    authority := uri.substring_view(authority_start, at);
    out: String_Builder;
    defer out.free();
    remote := authority.count > 0 && authority != "localhost";
    if remote {
        out.write_string("//");
        out.write_string(authority);
    }
    while at < uri.count {
        byte := workspace_byte(uri, at);
        if #partial byte == {
            case #char "%";
                if at + 2 >= uri.count return "".clone(), false;
                high := workspace_hex(workspace_byte(uri, at + 1));
                low := workspace_hex(workspace_byte(uri, at + 2));
                if high < 0 || low < 0 return "".clone(), false;
                byte = cast(u8)(high * 16 + low);
                at += 2;
            case #char "?", #char "#"; return "".clone(), false;
        }
        if byte == 0 return "".clone(), false;
        out.write_byte(byte);
        at += 1;
    }
    if !out.to_string().bytes().utf8_is_valid() return "".clone(), false;
    return out.clone(), remote;
}

/// Percent-encodes bytes, including UTF-8, so editor URIs round-trip exactly.
#public workspace_path_to_uri :: (path: str) -> str {
    normalized := workspace_normalize_path(path);
    defer normalized.free();
    return workspace_encode_uri(normalized);
}

/// Encodes an absolute path as a file URI exactly as spelled.
workspace_encode_uri :: (normalized: str) -> str {
    out: String_Builder;
    if workspace_prefix(normalized, "//") out.write_string("file:");
    else out.write_string("file://");
    if workspace_drive_path(normalized) out.write_byte(#char "/");
    hex :: "0123456789ABCDEF";
    for byte: normalized.bytes() {
        if byte == {
            case #char "A"..=#char "Z", #char "a"..=#char "z", #char "0"..=#char "9",
                 #char "-", #char "_", #char ".", #char "~", #char "/", #char ":";
                out.write_byte(byte);
            else;
                out.write_byte(#char "%");
                out.write_byte(hex.bytes()[cast(ssize)(byte / 16)]);
                out.write_byte(hex.bytes()[cast(ssize)(byte % 16)]);
        }
    }
    return out.into_string();
}

#public workspace_environment :: (name: str) -> str {
    if environment_get(name) == {
        case .Ok(value);
            if value == {
                case ?found; return found.value.clone();
                case null;
            }
        case .Err;
    }
    return "".clone();
}

#public workspace_init :: (workspace: *Workspace) {
    standard := workspace_environment("GLOSSO_STD");
    defer standard.free();
    if standard.count > 0 {
        workspace_set_std_path(workspace, standard);
        return;
    }
    configured := config_std_path();
    defer configured.free();
    if configured.count > 0 {
        workspace_set_std_path(workspace, configured);
        return;
    }
    installed := config_default_std_path();
    defer installed.free();
    workspace_set_std_path(workspace, installed);
}

#public workspace_set_std_path :: (workspace: *Workspace, path: str) {
    next := workspace_normalize_path(path);
    if workspace.std_path == next {
        next.free();
        return;
    }
    workspace.std_path.free();
    workspace.std_path = next;
    workspace.prelude = -1;
    if next.count > 0 {
        entry := path_join(next, "Prelude/module.glo");
        defer entry.free();
        // The prelude is always loaded and never counts toward `file_limit`.
        workspace.uncounted_loads += 1;
        workspace.prelude = workspace_load(workspace, entry);
        workspace.uncounted_loads -= 1;
    }
    workspace.revision += 1;
    workspace.generation = workspace.revision;
    workspace_invalidate_compiler(workspace);
    workspace_refresh_imports(workspace);
}

#public workspace_add_import_path :: (workspace: *Workspace, path: str) {
    normalized := workspace_normalize_path(path);
    for existing: workspace.import_paths.view() {
        if existing == normalized {
            normalized.free();
            return;
        }
    }
    workspace.import_paths.push(normalized);
    workspace.revision += 1;
    workspace.generation = workspace.revision;
    workspace_invalidate_compiler(workspace);
    workspace_refresh_imports(workspace);
}

#public workspace_touch :: (workspace: *Workspace, index: ssize) {
    workspace.revision += 1;
    workspace.generation = workspace.revision;
    if !workspace.files[index].generated workspace_invalidate_compiler(workspace);
    workspace.files[index].revision = workspace.revision;
}

#public workspace_find_path :: (workspace: *const Workspace, path: str) -> ssize {
    for i: 0..workspace.files.count {
        existing := workspace.files[i].path;
        if existing == path return i;
        #if OUT.os == Target_OS.Windows {
            if environment_names_equal(existing, path) return i;
        }
    }
    return -1;
}

#public workspace_find :: (workspace: *const Workspace, uri: str) -> ssize {
    path := workspace_uri_to_path(uri);
    defer path.free();
    if path.count > 0 return workspace_find_path(workspace, path);
    for i: 0..workspace.files.count {
        if workspace.files[i].uri == uri return i;
        for alias: workspace.files[i].aliases.view() if alias == uri return i;
    }
    return -1;
}

/// The URI for a resolved path. Below a root opened through a symbolic link
/// it keeps the editor's spelling, so navigation reuses the editor's tabs.
#public workspace_file_uri :: (workspace: *const Workspace, path: str) -> str {
    for i: 0..workspace.root_uris.count {
        root := workspace.roots[i];
        if workspace_suffix(root, "/") || !workspace_prefix(path, root) ||
           (path.count > root.count && path[root.count] != #char "/") continue;
        spelled, remote := workspace_uri_decode(workspace.root_uris[i]);
        defer spelled.free();
        if remote || workspace_byte(spelled, 0) != #char "/" ||
           workspace_drive_path(spelled.substring_view(1, spelled.count)) continue;
        lexical := path_clean(spelled);
        defer lexical.free();
        if lexical == root || workspace_suffix(lexical, "/") continue;
        builder: String_Builder;
        defer builder.free();
        builder.write_string(lexical);
        builder.write_string(path.substring_view(root.count, path.count));
        return workspace_encode_uri(builder.to_string());
    }
    return workspace_path_to_uri(path);
}

/// A stable overlay path for an `untitled:` buffer, outside every project, so
/// the compiler can check it. Relative imports from it do not resolve.
workspace_untitled_path :: (index: ssize) -> str {
    base: str;
    if temp_directory_path() == {
        case .Ok(value); base = value;
        case .Err; base = "/tmp".clone();
    }
    defer base.free();
    name := tprint("glolsp-untitled/{}.glo", index);
    joined := path_join(base, name);
    defer joined.free();
    return workspace_normalize_path(joined);
}

#public workspace_clear_compiler_facts :: (file: *Source_File) {
    for binding: file.compiler_bindings.view() binding.name.free();
    file.compiler_bindings.free();
    for fact: file.compiler_facts.view() fact.type_name.free();
    file.compiler_facts.free();
    file.compiler_binding_keys.reset();
    file.compiler_fact_keys.reset();
    file.compiler_fact_order.free();
    file.compiler_fact_span = 0;
    file.generated_files.free();
}

/// Rebuilds the offset index after facts were added.
#public workspace_index_compiler_facts :: (file: *Source_File) {
    file.compiler_fact_order.free();
    file.compiler_fact_span = 0;
    for fact, index: file.compiler_facts.view() {
        file.compiler_fact_order.push((cast(u64)fact.start << 32) | cast(u64)index);
        if fact.end - fact.start > file.compiler_fact_span
            file.compiler_fact_span = fact.end - fact.start;
    }
    _ := file.compiler_fact_order.view().sort(false);
}

#public workspace_invalidate_compiler :: (workspace: *Workspace) {
    workspace.compiler_epoch += 1;
    workspace.analyzed_generation = -1;
    for i: 0..workspace.files.count workspace_clear_compiler_facts(&workspace.files[i]);
}

/// The earliest-reported fact of `kind` (any kind for 0) whose range holds `at`.
#public workspace_compiler_fact :: (workspace: *const Workspace, file: ssize, at: ssize,
    kind: s32 = 0) -> Compiler_Fact {
    facts := workspace.files[file].compiler_facts.view();
    order := workspace.files[file].compiler_fact_order.view();
    if order.count != facts.count {
        for fact: facts {
            if (kind == 0 || kind == fact.kind) && at >= fact.start && at < fact.end return fact;
        }
        return .{};
    }
    if at < 0 return .{};
    // Find the first fact that starts after `at`, then walk back over the
    // facts that start close enough to still contain it.
    low: ssize = 0;
    high := order.count;
    while low < high {
        middle := low + (high - low) / 2;
        if cast(ssize)(order[middle] >> 32) <= at low = middle + 1;
        else high = middle;
    }
    span := workspace.files[file].compiler_fact_span;
    best: ssize = -1;
    cursor := low - 1;
    while cursor >= 0 {
        start := cast(ssize)(order[cursor] >> 32);
        if at - start >= span break;
        index := cast(ssize)(order[cursor] & 16#ffff_ffff);
        fact := facts[index];
        if at < fact.end && (kind == 0 || kind == fact.kind) && (best < 0 || index < best)
            best = index;
        cursor -= 1;
    }
    if best < 0 return .{};
    return facts[best];
}

#public workspace_clear_semantics :: (file: *Source_File) {
    // Includes the per-scope symbol index built with each analysis.
    file_semantics_free(&file.semantic);
    file.semantic.revision = -1;
}

#public workspace_clear_syntax :: (file: *Source_File) {
    workspace_clear_semantics(file);
    destroy_parsed_file(&file.syntax);
    file.imports.free();
}

/// Clearing a file retains its identity; references never change to another file.
#public workspace_unload :: (workspace: *Workspace, index: ssize) {
    file := &workspace.files[index];
    workspace_clear_syntax(file);
    file.source.free();
    empty: str;
    file.source = empty;
    file.active = false;
    // An unloaded file has nothing to diagnose; drop its last snapshot.
    if file.compiler_ready file.compiler_document.destroy();
    file.compiler_ready = false;
    file.compiler_error.free();
    file.compiler_error = empty;
    file.compiler_output.free();
    file.compiler_output = empty;
    workspace_clear_aliases(file);
    workspace_touch(workspace, index);
}

workspace_clear_aliases :: (file: *Source_File) {
    for alias: file.aliases.view() alias.free();
    file.aliases.free();
    file.open = false;
}

#public workspace_destroy :: (workspace: *Workspace) {
    for i: 0..workspace.files.count {
        file := &workspace.files[i];
        workspace_clear_syntax(file);
        workspace_clear_compiler_facts(file);
        if file.compiler_ready file.compiler_document.destroy();
        file.compiler_error.free();
        file.compiler_output.free();
        workspace_clear_aliases(file);
        file.source.free(); file.path.free(); file.uri.free();
    }
    workspace.files.free();
    workspace.counted_files = 0;
    for root: workspace.roots.view() root.free();
    workspace.roots.free();
    for uri: workspace.root_uris.view() uri.free();
    workspace.root_uris.free();
    for path: workspace.import_paths.view() path.free();
    workspace.import_paths.free();
    workspace.std_path.free();
    empty: str;
    workspace.std_path = empty;
    workspace.prelude = -1;
    for i: 0..workspace.types.count {
        workspace.types[i].parameters.free();
        workspace.types[i].arguments.free();
    }
    workspace.types.free();
    workspace.unit_owners.free();
}

/// `file_limit` bounds discovered files only: an editor buffer, the prelude,
/// or a generated source is always admitted.
#public workspace_allocate :: (
    workspace: *Workspace, uri: str, path: str, counted: bool = true,
) -> ssize {
    if counted && workspace.uncounted_loads > 0 counted = false;
    if counted && workspace.counted_files >= workspace.file_limit {
        workspace.truncated = true;
        return -1;
    }
    workspace.files.push(.{ .uri = uri.clone(), .path = path.clone(), .counted = counted });
    if counted workspace.counted_files += 1;
    return workspace.files.count - 1;
}

#public workspace_replace_source :: (workspace: *Workspace, index: ssize, source: str) -> bool {
    if source.count > workspace.source_limit || !source.bytes().utf8_is_valid() return false;
    file := &workspace.files[index];
    if file.active && file.source == source return true;
    // Clone before releasing: callers may supply a view of the previous buffer.
    next := source.clone();
    workspace_clear_syntax(file);
    file.source.free();
    file.source = next;
    parsed := parse_file(file.source);
    value_replace(&file.syntax, parsed);
    file.active = true;
    workspace.parse_count += 1;
    workspace_touch(workspace, index);
    workspace_rebuild_imports(workspace, index);
    return true;
}

/// Returns the persistent file identity and loads dependencies recursively.
#public workspace_load :: (workspace: *Workspace, path: str) -> ssize {
    normalized := workspace_normalize_path(path);
    defer normalized.free();
    index := workspace_find_path(workspace, normalized);
    if index >= 0 && workspace.files[index].active return index;
    if workspace.import_depth >= 256 {
        workspace.truncated = true;
        return -1;
    }
    if read_file_up_to(normalized, workspace.source_limit + 1) == {
        case .Err; return -1;
        case .Ok(source);
            defer source.free();
            if source.count > workspace.source_limit || !source.bytes().utf8_is_valid() return -1;
            if index < 0 {
                uri := workspace_file_uri(workspace, normalized);
                defer uri.free();
                index = workspace_allocate(workspace, uri, normalized);
            }
            if index < 0 return -1;
            workspace.import_depth += 1;
            defer { workspace.import_depth -= 1; }
            if !workspace_replace_source(workspace, index, source) return -1;
            return index;
    }
}

#public workspace_open :: (
    workspace: *Workspace, uri: str, source: str, version: ssize,
) -> ssize {
    if source.count > workspace.source_limit || !source.bytes().utf8_is_valid() return -1;
    index := workspace_find(workspace, uri);
    if index < 0 {
        path := workspace_uri_to_path(uri);
        defer path.free();
        // An untitled buffer gets an overlay path so the compiler can check it.
        if path.count == 0 && workspace_prefix(uri, "untitled:") {
            path.free();
            path = workspace_untitled_path(workspace.files.count);
        }
        index = workspace_allocate(workspace, uri, path, false);
    }
    if index < 0 return -1;
    was_open := workspace.files[index].open;
    // Clone first: callers may pass a view of this file's URI.
    next_uri := uri.clone();
    file := &workspace.files[index];
    seen := false;
    for alias: file.aliases.view() if alias == next_uri seen = true;
    if !seen file.aliases.push(next_uri.clone());
    file.uri.free();
    file.uri = next_uri;
    file.open = true;
    file.version = version;
    if !workspace_replace_source(workspace, index, source) return -1;
    if !was_open workspace_touch(workspace, index);
    workspace_refresh_imports(workspace);
    return index;
}

#public workspace_change :: (
    workspace: *Workspace, index: ssize, source: str, version: ssize,
) -> bool {
    if index < 0 || index >= workspace.files.count return false;
    if !workspace.files[index].open || version <= workspace.files[index].version return false;
    if !workspace_replace_source(workspace, index, source) return false;
    workspace.files[index].version = version;
    workspace_refresh_relevance(workspace);
    return true;
}

#public workspace_reload :: (workspace: *Workspace, index: ssize) {
    if workspace.files[index].open return;
    path := workspace.files[index].path.clone();
    defer path.free();
    if read_file_up_to(path, workspace.source_limit + 1) == {
        case .Ok(source);
            defer source.free();
            if workspace_replace_source(workspace, index, source) return;
        case .Err;
    }
    workspace_unload(workspace, index);
}

/// Closes one editor URI. The file stays open while another URI for it, such
/// as a path through a symbolic link, remains open. Without a URI, or with an
/// unknown one, every URI closes.
#public workspace_close :: (workspace: *Workspace, index: ssize, uri: str = "") {
    if index < 0 || index >= workspace.files.count return;
    file := &workspace.files[index];
    if uri.count > 0 && file.aliases.count > 1 {
        for i: 0..file.aliases.count {
            if file.aliases[i] != uri continue;
            file.aliases[i].free();
            for next: i + 1..file.aliases.count file.aliases[next - 1] = file.aliases[next];
            _ := array_pop_last(&file.aliases);
            remaining := file.aliases[file.aliases.count - 1].clone();
            file.uri.free();
            file.uri = remaining;
            return;
        }
    }
    workspace_clear_aliases(file);
    workspace_reload(workspace, index);
    workspace_refresh_imports(workspace);
}

#public workspace_import_path :: (raw: str) -> str {
    out: String_Builder;
    defer out.free();
    at: ssize = 0;
    while at < raw.count {
        byte := workspace_byte(raw, at);
        if byte == #char "\\" {
            at += 1;
            byte = workspace_byte(raw, at);
            if byte == {
                case #char "\\", #char "\"", #char "/";
                case #char "n"; byte = #char "\n";
                case #char "r"; byte = #char "\r";
                case #char "t"; byte = #char "\t";
                case #char "x";
                    high := workspace_hex(workspace_byte(raw, at + 1));
                    low := workspace_hex(workspace_byte(raw, at + 2));
                    if high < 0 || low < 0 return "".clone();
                    byte = cast(u8)(high * 16 + low);
                    at += 2;
                case #char "u";
                    if workspace_byte(raw, at + 1) != #char "{" return "".clone();
                    at += 2;
                    scalar: u32 = 0;
                    digits: ssize = 0;
                    while workspace_byte(raw, at) != #char "}" {
                        digit := workspace_hex(workspace_byte(raw, at));
                        if digit < 0 || digits >= 6 return "".clone();
                        scalar = scalar * 16 + cast(u32)digit;
                        digits += 1;
                        at += 1;
                    }
                    if digits == 0 || scalar == 0 || scalar > 16#10_ffff ||
                       (scalar >= 16#d800 && scalar <= 16#dfff) return "".clone();
                    _ := out.write_rune(cast(rune)scalar);
                    at += 1;
                    continue;
                else; return "".clone();
            }
        }
        if byte == 0 return "".clone();
        out.write_byte(byte);
        at += 1;
    }
    return out.clone();
}

#public workspace_valid_module :: (name: str) -> bool {
    if name.count == 0 return false;
    start: ssize = 0;
    for at: 0..name.count + 1 {
        byte := workspace_byte(name, at);
        if byte == #char "\\" || byte == #char ":" return false;
        if at < name.count && byte != #char "/" continue;
        component := name.substring_view(start, at);
        if component.count == 0 || component == "." || component == ".." return false;
        start = at + 1;
    }
    return true;
}

#public workspace_candidate :: (workspace: *Workspace, path: str) -> ssize {
    normalized := workspace_normalize_path(path);
    defer normalized.free();
    index := workspace_find_path(workspace, normalized);
    if index >= 0 && workspace.files[index].active return index;
    if !is_regular_file(normalized).unwrap_or(false) return -1;
    return workspace_load(workspace, normalized);
}

#public workspace_candidate_exists :: (workspace: *const Workspace, path: str) -> bool {
    normalized := workspace_normalize_path(path);
    defer normalized.free();
    index := workspace_find_path(workspace, normalized);
    return (index >= 0 && workspace.files[index].active) || is_regular_file(normalized).unwrap_or(false);
}

// Probe without loading source: completion must not grow or reparse the workspace.
#public workspace_module_path :: (
    workspace: *const Workspace, root: str, name: str,
) -> (str, bool) {
    if root.count == 0 return "".clone(), false;
    base := path_join(root, name);
    defer base.free();
    builder: String_Builder;
    defer builder.free();
    builder.write_string(base);
    builder.write_string(".glo");
    entry := path_join(base, "module.glo");
    defer entry.free();
    single := workspace_candidate_exists(workspace, builder.to_string());
    directory := workspace_candidate_exists(workspace, entry);
    if single && directory return "".clone(), true;
    if single return builder.clone(), false;
    if directory return entry.clone(), false;
    return "".clone(), false;
}

// Use the same root precedence for loading and completion: the standard
// library, import paths, then (when enabled) the workspace roots.
#public workspace_module_root_count :: (workspace: *const Workspace) -> ssize {
    count := 1 + workspace.import_paths.count;
    if workspace.roots_as_module_paths count += workspace.roots.count;
    return count;
}

#public workspace_set_roots_as_module_paths :: (workspace: *Workspace, enabled: bool) {
    if workspace.roots_as_module_paths == enabled return;
    workspace.roots_as_module_paths = enabled;
    workspace.revision += 1;
    workspace.generation = workspace.revision;
    workspace_invalidate_compiler(workspace);
    workspace_refresh_imports(workspace);
}

#public workspace_module_root :: (workspace: *const Workspace, index: ssize) -> str {
    if index == 0 return workspace.std_path;
    if index <= workspace.import_paths.count return workspace.import_paths[index - 1];
    return workspace.roots[index - workspace.import_paths.count - 1];
}

#public workspace_find_module :: (workspace: *const Workspace, name: str) -> (str, bool) {
    for i: 0..workspace_module_root_count(workspace) {
        candidate, conflict := workspace_module_path(workspace,
            workspace_module_root(workspace, i), name);
        if candidate.count > 0 || conflict return candidate, conflict;
        candidate.free();
    }
    return "".clone(), false;
}

#public workspace_source_import :: (name: str) -> bool {
    return workspace_prefix(name, "./") || workspace_prefix(name, "../") ||
        path_is_absolute(name) || workspace_suffix(name, ".glo");
}

#public workspace_resolve_import :: (
    workspace: *Workspace, source_path: str, declaration: Syntax_Import,
) -> ssize {
    if declaration.embedded && !declaration.load return -1;
    name := workspace_import_path(declaration.path);
    defer name.free();
    if name.count == 0 return -1;
    // `#export "Module"` re-exports a module by name, like `#import`.
    if declaration.load || workspace_source_import(name) {
        path := path_join(path_dirname(source_path), name);
        defer path.free();
        if is_directory(path).unwrap_or(false) || !workspace_suffix(path, ".glo") {
            entry := path_join(path, "module.glo");
            defer entry.free();
            return workspace_candidate(workspace, entry);
        }
        return workspace_candidate(workspace, path);
    }
    if !workspace_valid_module(name) return -1;
    for i: 0..workspace_module_root_count(workspace) {
        path, ambiguous := workspace_module_path(workspace,
            workspace_module_root(workspace, i), name);
        defer path.free();
        if ambiguous return -2;
        if path.count == 0 continue;
        index := workspace_candidate(workspace, path);
        if index >= 0 return index;
    }
    return -1;
}

#public workspace_completion_push :: (
    result: *Workspace_Path_Completions, name: str, prefix: str,
) {
    if !workspace_prefix(name, prefix) return;
    for existing: result.paths.view() if existing == name return;
    if result.paths.count >= 500 {
        result.incomplete = true;
        return;
    }
    result.paths.push(name.clone());
}

#public workspace_ignored_directory :: (name: str) -> bool {
    if name == {
        case ".git", ".hg", ".svn", "build", "node_modules", ".cache"; return true;
        else; return false;
    }
}

#public workspace_completion_entry :: (
    workspace: *const Workspace, result: *Workspace_Path_Completions,
    prefix: str, parent: str, entry: str, directory: bool, load: bool,
) {
    if directory && workspace_ignored_directory(entry) return;
    if !directory && !workspace_suffix(entry, ".glo") return;
    name: String_Builder;
    defer name.free();
    name.write_string(parent);
    if directory || load name.write_string(entry);
    else name.write_string(entry.substring_view(0, entry.count - 4));
    candidate := name.to_string();
    if !load && !workspace_valid_module(candidate) return;
    if workspace_prefix(candidate, prefix) {
        if load {
            if !directory workspace_completion_push(result, candidate, prefix);
        } else {
            path, ambiguous := workspace_find_module(workspace, candidate);
            defer path.free();
            if path.count > 0 && !ambiguous workspace_completion_push(result, candidate, prefix);
        }
    }
    if directory {
        name.write_byte(#char "/");
        workspace_completion_push(result, name.to_string(), prefix);
    }
}

#public workspace_completion_directory :: (
    workspace: *const Workspace, result: *Workspace_Path_Completions,
    directory_path: str, prefix: str, parent: str, load: bool,
) -> Fs_Error!void {
    directory := Directory.open_directory(directory_path)?;
    defer { _ := directory.close(); }
    visited: ssize = 0;
    while !result.incomplete {
        next := directory.next()?;
        if next == {
            case null; break;
            case ?entry;
                if visited >= workspace.file_limit {
                    result.incomplete = true;
                    break;
                }
                visited += 1;
                path := path_join(directory_path, entry.name);
                defer path.free();
                entry_is_directory := is_directory(path).unwrap_or(false);
                if entry_is_directory || is_regular_file(path).unwrap_or(false)
                    workspace_completion_entry(workspace, result, prefix, parent,
                        entry.name, entry_is_directory, load);
        }
    }
    return .Ok;
}

#public workspace_completion_root :: (
    workspace: *const Workspace, result: *Workspace_Path_Completions,
    root: str, prefix: str, parent: str, load: bool,
) {
    if root.count == 0 || result.incomplete return;
    joined := path_join(root, parent);
    defer joined.free();
    directory_path := workspace_normalize_path(joined);
    defer directory_path.free();
    _ := workspace_completion_directory(workspace, result, directory_path, prefix, parent, load);
    // Unsaved files and directories implied by open buffers are importable too.
    base: String_Builder;
    defer base.free();
    base.write_string(directory_path);
    if !workspace_suffix(directory_path, "/") base.write_byte(#char "/");
    for index: 0..workspace.files.count {
        file := &workspace.files[index];
        if !file.active || !workspace_prefix(file.path, base.to_string()) continue;
        relative := file.path.substring_view(base.to_string().count, file.path.count);
        end: ssize = 0;
        while end < relative.count && relative[end] != #char "/" end += 1;
        workspace_completion_entry(workspace, result, prefix, parent,
            relative.substring_view(0, end), end < relative.count, load);
    }
}

/// Lists the current path component without parsing candidates or scanning subtrees.
/// The caller owns the returned strings.
#public workspace_complete_import :: (
    workspace: *const Workspace, file: ssize, raw_prefix: str, load: bool,
) -> Workspace_Path_Completions {
    result: Workspace_Path_Completions;
    prefix := workspace_import_path(raw_prefix);
    defer prefix.free();
    if raw_prefix.count > 0 && prefix.count == 0 return result;
    parent_end: ssize = 0;
    for at: 0..prefix.count if prefix[at] == #char "/" parent_end = at + 1;
    parent := prefix.substring_view(0, parent_end);
    if load || workspace_source_import(prefix) {
        if file < 0 return result;
        source_path := workspace.files[file].path;
        if source_path.count > 0 workspace_completion_root(workspace, &result,
            path_dirname(source_path), prefix, parent, true);
    } else {
        if prefix.count > 0 {
            check := prefix;
            if workspace_suffix(check, "/") check = check.substring_view(0, check.count - 1);
            if !workspace_valid_module(check) return result;
        }
        for i: 0..workspace_module_root_count(workspace)
            workspace_completion_root(workspace, &result, workspace_module_root(workspace, i),
                prefix, parent, false);
    }
    return result;
}

#public workspace_rebuild_imports :: (workspace: *Workspace, index: ssize) {
    previous := workspace.files[index].imports.take();
    defer previous.free();
    source_path := workspace.files[index].path.clone();
    defer source_path.free();
    count := workspace.files[index].syntax.imports.count;
    for i: 0..count {
        // Loading may grow files; retain indices instead of pointers into the array.
        declaration := workspace.files[index].syntax.imports[i];
        target := workspace_resolve_import(workspace, source_path, declaration);
        ambiguous := target == -2;
        if target < 0 target = -1;
        workspace.files[index].imports.push(.{
            .declaration = i, .target = target, .ambiguous = ambiguous,
        });
    }
    changed := previous.count != workspace.files[index].imports.count;
    if !changed {
        for i: 0..previous.count {
            current := workspace.files[index].imports[i];
            if previous[i].target != current.target || previous[i].ambiguous != current.ambiguous
                changed = true;
        }
    }
    if changed workspace_touch(workspace, index);
}

#public workspace_refresh_imports :: (workspace: *Workspace) {
    count := workspace.files.count;
    for i: 0..count {
        if workspace.files[i].active workspace_rebuild_imports(workspace, i);
    }
    workspace_refresh_relevance(workspace);
}

/// Visible project files and their dependencies; cached orphan files retain their IDs.
#public workspace_refresh_relevance :: (workspace: *Workspace) {
    for i: 0..workspace.files.count {
        file := &workspace.files[i];
        file.relevant = file.active && (file.open || i == workspace.prelude);
        if !file.active continue;
        // A generated source is relevant only while its owner uses it, even
        // when the cache lies below a root.
        if file.generated continue;
        for root: workspace.roots.view() {
            if file.path.count > 0 && path_lexically_contains(root, file.path)
                file.relevant = true;
        }
    }
    changed := true;
    while changed {
        changed = false;
        for i: 0..workspace.files.count {
            if !workspace.files[i].relevant continue;
            for generated: workspace.files[i].generated_files.view() {
                if workspace.files[generated].active && !workspace.files[generated].relevant {
                    workspace.files[generated].relevant = true;
                    changed = true;
                }
            }
            for edge: workspace.files[i].imports.view() {
                if edge.target < 0 || !workspace.files[edge.target].active ||
                   workspace.files[edge.target].relevant continue;
                workspace.files[edge.target].relevant = true;
                changed = true;
            }
        }
    }
}

#public workspace_file_relevant :: (workspace: *const Workspace, index: ssize) -> bool {
    return index >= 0 && index < workspace.files.count && workspace.files[index].relevant;
}

/// Open buffers take precedence over watched disk changes, including deletions.
#public workspace_watch :: (workspace: *Workspace, uri: str) {
    // Watch notifications may also name data read by compile-time code.
    workspace_invalidate_compiler(workspace);
    workspace_watch_file(workspace, uri);
    workspace_refresh_imports(workspace);
}

/// Reloads one watched file. A batch of changes invalidates the compiler
/// before its first file and refreshes imports once after its last.
#public workspace_watch_file :: (workspace: *Workspace, uri: str) {
    index := workspace_find(workspace, uri);
    if index >= 0 workspace_reload(workspace, index);
    else {
        path := workspace_uri_to_path(uri);
        defer path.free();
        if path.count > 0 && workspace_suffix(path, ".glo") _ := workspace_load(workspace, path);
    }
}

#public workspace_walk_visit :: (path: str, entry: Directory_Entry, depth: ssize) -> Walk_Control {
    if #pattern ?pointer = context.user_ptr {
        workspace := cast(*Workspace)pointer;
        if workspace.counted_files >= workspace.file_limit {
            workspace.truncated = true;
            return .Stop;
        }
        if entry.kind == File_Kind.Directory {
            if depth >= 64 || workspace_ignored_directory(entry.name) return .Skip_Directory;
            // The walk aborts on a directory it cannot open; skip it instead.
            if Directory.open_directory(path) == {
                case .Ok(directory); _ := directory.close();
                case .Err; return .Skip_Directory;
            }
        }
        if entry.kind == File_Kind.Regular && workspace_suffix(path, ".glo")
            _ := workspace_load(workspace, path);
    }
    return .Continue;
}

#public workspace_add_root :: (workspace: *Workspace, uri: str) {
    path := workspace_uri_to_path(uri);
    defer path.free();
    if path.count == 0 return;
    for root: workspace.roots.view() {
        if root == path return;
    }
    workspace.roots.push(path.clone());
    workspace.root_uris.push(uri.clone());
    workspace.revision += 1;
    workspace.generation = workspace.revision;
    workspace_invalidate_compiler(workspace);
    workspace_refresh_imports(workspace);
}

#public workspace_remove_root :: (workspace: *Workspace, uri: str) {
    path := workspace_uri_to_path(uri);
    defer path.free();
    for i: 0..workspace.roots.count {
        if workspace.roots[i] != path continue;
        workspace.roots[i].free();
        workspace.root_uris[i].free();
        for next: i + 1..workspace.roots.count {
            workspace.roots[next - 1] = workspace.roots[next];
            workspace.root_uris[next - 1] = workspace.root_uris[next];
        }
        _ := array_pop_last(&workspace.roots);
        _ := array_pop_last(&workspace.root_uris);
        workspace.revision += 1;
        workspace.generation = workspace.revision;
        workspace_invalidate_compiler(workspace);
        workspace_refresh_imports(workspace);
        return;
    }
}

#public workspace_scan_root :: (workspace: *Workspace, uri: str) {
    workspace_add_root(workspace, uri);
    path := workspace_uri_to_path(uri);
    defer path.free();
    if path.count == 0 || !is_directory(path).unwrap_or(false) return;
    scoped := context;
    scoped.user_ptr = ?(cast(*void)workspace);
    #push_context scoped {
        _ := walk(path, workspace_walk_visit);
    }
    workspace_refresh_imports(workspace);
}
