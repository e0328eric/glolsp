//! Token colors follow the resolved declaration, including imported members.
#load "semantic.glo";
#load "workspace.glo";
#load "analysis.glo";
#load "model.glo";
#import "String_Builder";

#public write_resolved_semantic_tokens :: (
    out: *String_Builder, workspace: *Workspace, file: ssize,
) {
    analyze_workspace(workspace);
    source := workspace.files[file].source;
    syntax := &workspace.files[file].syntax;
    cursor: Semantic_Cursor;
    out.write_string("{\"data\":[");
    for index: 0..syntax.language.tokens.count {
        token := syntax.language.tokens[index];
        style: Semantic_Style = .{ .token_type = -1 };
        if token.kind == {
            case 1;
                id := workspace.files[file].semantic.bindings[index];
                if id.file >= 0 && id.symbol >= 0 {
                    symbol := workspace.files[id.file].syntax.symbols[id.symbol];
                    style.token_type = 3;
                    if symbol.kind == {
                        case 2; style.token_type = 0;
                        case 10, 11, 23, 26; style.token_type = 1;
                        case 12, 6; style.token_type = 2;
                        case 8; style.token_type = 5;
                        case 14, 22; style.modifiers = 2;
                        else; {}
                    }
                    if symbol.node >= 0 &&
                       workspace.files[id.file].syntax.nodes[symbol.node].kind == .Parameter
                        style.token_type = 4;
                    if id.file == file && symbol.selection_start == token.start
                        style.modifiers |= 1;
                } else if semantic_builtin_type(source[token.start..token.end]) {
                    style.token_type = 1;
                }
            case 2; style.token_type = 9;
            case 3; style.token_type = 8;
            case 4; style.token_type = 7;
            case 5; style.token_type = 6;
            case 7; style.token_type = 11;
            else;
                text := source[token.start..token.end];
                if text == {
                    case "(", ")", "{", "}", "[", "]", ";", ",", ".";
                    else; style.token_type = 10;
                }
        }
        semantic_advance(source, &cursor, token.start);
        while cursor.byte < token.end {
            line := cursor.line;
            character := cursor.character;
            end := cursor.byte;
            while end < token.end && source[end] != #char "\r" &&
                  source[end] != #char "\n" end += 1;
            semantic_advance(source, &cursor, end);
            semantic_emit_span(out, &cursor, line, character, cursor.character - character, style);
            if cursor.byte < token.end semantic_advance(source, &cursor, cursor.byte + 1);
        }
    }
    out.write_string("]}");
}
