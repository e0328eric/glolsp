//! Editor features operate on resolved declarations and workspace snapshots.
#import "model.glo";
#import "workspace.glo";
#import "analysis.glo";
#import "protocol.glo";
#import "positions.glo";
#import "String_Builder";
#import "Strings";
#import "Format";
#import "File_System/Path";

#public ide_valid_symbol :: (workspace: *Workspace, id: Symbol_Id) -> bool {
    return id.file >= 0 && id.file < workspace.files.count && id.symbol >= 0 && id.symbol <
        workspace.files[id.file].syntax.symbols.count;
}

#public ide_symbol_source :: (workspace: *Workspace, id: Symbol_Id) -> str {
    if !ide_valid_symbol(workspace, id) return "";
    return workspace.files[id.file].source;
}

#public ide_write_location :: (out: *String_Builder, workspace: *Workspace, id: Symbol_Id) {
    symbol := workspace.files[id.file].syntax.symbols[id.symbol];
    ide_write_occurrence(out, workspace, id.file, symbol.selection_start, symbol.selection_end);
}

#public ide_write_occurrence :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    start: ssize,
    end: ssize,
) {
    // If the compiler cannot materialize its cache, the insertion remains an
    // editor-readable definition target. Never expose an unusable file URI.
    document := &workspace.files[file];
    if document.generated && document.path.starts_with("<") && document.generated_origin >= 0 {
        ide_write_occurrence(out, workspace, document.generated_origin,
            document.generated_start, document.generated_end);
        return;
    }
    out.write_string("{\"uri\":");
    write_json_string(out, workspace.files[file].uri);
    out.write_string(",\"range\":");
    write_range(out, workspace.files[file].source, start, end);
    out.write_byte(#char "}");
}

#public ide_write_hover :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    offset: ssize,
) {
    id := analysis_symbol_at(workspace, file, offset);
    if !ide_valid_symbol(workspace, id) {
        out.write_string("null");
        return;
    }
    syntax := &workspace.files[file].syntax;
    token_index := analysis_token_at(workspace, file, offset);
    // A cursor just after the name reads the facts of the name itself.
    at := offset;
    if token_index >= 0 && syntax.language.tokens[token_index].end == offset
        at = syntax.language.tokens[token_index].start;
    symbol := workspace.files[id.file].syntax.symbols[id.symbol];
    signature: String_Builder;
    defer signature.free();
    if symbol.type_node < 0 && symbol.kind == 13 {
        signature.write_string(symbol.name);
        signature.write_string(": ");
        fact := workspace_compiler_fact(workspace, file, at, 2);
        if fact.type_name.count == 0
            fact = workspace_compiler_fact(workspace, id.file, symbol.selection_start, 1);
        if fact.type_name.count > 0 signature.write_string(fact.type_name);
        else analysis_write_type(&signature, workspace, analysis_type(workspace, id));
    } else signature.write_string(symbol.detail);
    out.write_string("{\"contents\":[{\"language\":\"glosso\",\"value\":");
    write_json_string(out, signature.to_string());
    out.write_byte(#char "}");
    if symbol.documentation.count > 0 {
        out.write_string(",{\"language\":\"text\",\"value\":");
        write_json_string(out, symbol.documentation);
        out.write_byte(#char "}");
    }
    out.write_string("],\"range\":");
    if token_index >= 0 {
        token := syntax.language.tokens[token_index];
        write_range(out, workspace.files[file].source, token.start, token.end);
    } else write_range(out, workspace.files[file].source, offset, offset);
    out.write_byte(#char "}");
}

#public ide_write_references :: (
    out: *String_Builder,
    workspace: *Workspace,
    id: Symbol_Id,
    include_declaration: bool,
    local_file: ssize = -1,
    highlight: bool = false,
) {
    out.write_byte(#char "[");
    count: ssize = 0;
    if ide_valid_symbol(workspace, id) {
        declaration := workspace.files[id.file].syntax.symbols[id.symbol];
        for file: 0..workspace.files.count {
            if !workspace.files[file].active || !workspace.files[file].relevant ||
                (local_file >= 0 && file != local_file) continue;
            for token: 0..workspace.files[file].semantic.bindings.count {
                bound := workspace.files[file].semantic.bindings[token];
                if !analysis_same_symbol(bound, id) continue;
                span := workspace.files[file].syntax.language.tokens[token];
                is_declaration := file == id.file && span.start == declaration.selection_start;
                if !include_declaration && is_declaration continue;
                if count > 0 out.write_byte(#char ",");
                count += 1;
                if highlight {
                    out.write_string("{\"kind\":1,\"range\":");
                    write_range(out, workspace.files[file].source, span.start, span.end);
                    out.write_byte(#char "}");
                } else ide_write_occurrence(out, workspace, file, span.start, span.end);
            }
        }
    }
    out.write_byte(#char "]");
}

// Whether `token` follows `.`. Member accesses and `.name` labels resolve in
// a type, not in the lexical scopes a rename can change.
#public ide_member_token :: (workspace: *Workspace, file: ssize, token: ssize) -> bool {
    language := &workspace.files[file].syntax.language;
    previous := token - 1;
    while previous >= 0 && language.tokens[previous].kind == 4 previous -= 1;
    if previous < 0 return false;
    span := language.tokens[previous];
    return workspace.files[file].source.substring(span.start, span.end) == ".";
}

// A token that rename rewrites: bound to `id` and spelled as its name. Uses
// of an alias stay bound to the alias, but never rewrite another spelling.
#public ide_renamed_token :: (
    workspace: *Workspace, file: ssize, token: ssize, id: Symbol_Id,
) -> bool {
    if !analysis_same_symbol(workspace.files[file].semantic.bindings[token], id) return false;
    span := workspace.files[file].syntax.language.tokens[token];
    return workspace.files[file].source.substring(span.start, span.end) ==
        workspace.files[id.file].syntax.symbols[id.symbol].name;
}

// Rename does not edit the standard library: the standard modules that use a
// declaration are not analysed. Only a workspace opened on the standard library
// itself edits it; a root such as $HOME that contains the installation does not.
#public ide_read_only_file :: (workspace: *Workspace, file: ssize) -> bool {
    path := workspace.files[file].path;
    if workspace.std_path.count == 0 || path.count == 0 ||
       !path_lexically_contains(workspace.std_path, path) return false;
    for root: workspace.roots.view() {
        if path_lexically_contains(workspace.std_path, root) && path_lexically_contains(root, path)
            return false;
    }
    return true;
}

// Why `id` cannot be renamed, or "" when it can. Generated files are cache
// artifacts: their text comes from an `#insert` that rename does not change.
#public ide_rename_rejection :: (workspace: *Workspace, id: Symbol_Id) -> str {
    if !ide_valid_symbol(workspace, id) return "A valid declared name is required.";
    if workspace.files[id.file].generated
        return "Generated declarations must be renamed in their #insert source.";
    if ide_read_only_file(workspace, id.file)
        return "Standard library declarations cannot be renamed.";
    for file: 0..workspace.files.count {
        if !workspace.files[file].relevant continue;
        for token: 0..workspace.files[file].semantic.bindings.count {
            if !ide_renamed_token(workspace, file, token, id) continue;
            if workspace.files[file].generated
                return "Generated code from an #insert uses this name; rename it in the #insert source.";
            if ide_read_only_file(workspace, file)
                return "The standard library uses this name.";
        }
    }
    return "";
}

// Whether `inner` is nested strictly inside `outer`.
#public ide_scope_inside :: (syntax: *const Parsed_File, inner: ssize, outer: ssize) -> bool {
    if inner < 0 || inner >= syntax.scopes.count return false;
    current := syntax.scopes[inner].parent;
    while current >= 0 && current < syntax.scopes.count {
        if current == outer return true;
        current = syntax.scopes[current].parent;
    }
    return false;
}

// Whether a bare `name` at `offset` already resolves: lexically, or to a
// field opened by `using`.
#public ide_name_visible :: (workspace: *Workspace, file: ssize, offset: ssize, name: str) -> bool {
    syntax := &workspace.files[file].syntax;
    scope := analysis_scope_at(syntax, offset);
    if analysis_valid(workspace, analysis_lookup(workspace, file, scope, name, offset)) return true;
    if syntax.usings.count == 0 return false;
    owner: Type_Id = 0;
    return analysis_valid(workspace, analysis_using_field(workspace, file, scope, name, offset, &owner));
}

// Whether `id` would be visible by its new name at `offset`, ignoring
// declarations that share its current name. `uses` marks files referring to it.
#public ide_rename_reaches :: (
    workspace: *Workspace, file: ssize, scope: ssize, offset: ssize, id: Symbol_Id,
    uses: []const bool,
) -> bool {
    renamed := workspace.files[id.file].syntax.symbols[id.symbol];
    if renamed.kind == 8 {
        // A field is a bare name only where a `using` opens its structure.
        if workspace.files[file].syntax.usings.count == 0 return false;
        owner: Type_Id = 0;
        return analysis_same_symbol(id, analysis_using_field(workspace, file, scope,
            renamed.name, offset, &owner));
    }
    if renamed.scope > 0 {
        if id.file != file return false;
        syntax := &workspace.files[file].syntax;
        current := scope;
        crossed := false;
        while current >= 0 && current < syntax.scopes.count {
            if current == renamed.scope {
                if crossed && analysis_in_procedure(syntax, current) &&
                   !analysis_outer_visible(renamed.kind) return false;
                return renamed.kind != 13 || analysis_local_ready(syntax, id.symbol, offset);
            }
            if analysis_procedure_scope(syntax, current) crossed = true;
            current = syntax.scopes[current].parent;
        }
        return false;
    }
    if id.file == file || uses[file] || analysis_same_unit(workspace, id.file, file) return true;
    for edge: workspace.files[file].imports.view() {
        if edge.target == id.file return true;
    }
    return false;
}

// Whether renaming `id` would make the bare use `token`, now bound to
// `bound`, resolve to `id` instead.
#public ide_rename_captures :: (
    workspace: *Workspace, file: ssize, token: ssize, id: Symbol_Id, bound: Symbol_Id,
    uses: []const bool,
) -> bool {
    if ide_member_token(workspace, file, token) return false;
    syntax := &workspace.files[file].syntax;
    span := syntax.language.tokens[token];
    if analysis_valid(workspace, bound) && bound.file == file &&
       syntax.symbols[bound.symbol].token == token return false;
    scope := analysis_scope_at(syntax, span.start);
    if !ide_rename_reaches(workspace, file, scope, span.start, id, uses) return false;
    // A use the server cannot resolve would start naming the declaration.
    if !analysis_valid(workspace, bound) return true;
    renamed := workspace.files[id.file].syntax.symbols[id.symbol];
    renamed_local := id.file == file && renamed.kind != 8 &&
        analysis_local_scope(syntax, scope, renamed.scope);
    existing := workspace.files[bound.file].syntax.symbols[bound.symbol];
    if bound.file == file && existing.kind != 8 &&
       analysis_local_scope(syntax, scope, existing.scope) {
        // Locals win over fields and top-level names; an inner local over an outer one.
        return renamed_local && !ide_scope_inside(syntax, existing.scope, renamed.scope);
    }
    if existing.kind == 8
        return renamed.kind == 8 || analysis_precedes_using(workspace, file, scope, id);
    if renamed_local return true;
    if renamed.kind == 8 return !analysis_precedes_using(workspace, file, scope, bound);
    // Declarations of this file come before imports; otherwise the name is ambiguous.
    return true;
}

// Rename must keep every use resolving as before. Existing references must
// not meet another `name`, and the renamed declaration must not capture an
// existing use of `name`.
#public ide_rename_conflicts :: (workspace: *Workspace, id: Symbol_Id, name: str) -> bool {
    if !ide_valid_symbol(workspace, id) return true;
    original := workspace.files[id.file].syntax.symbols[id.symbol];
    if name == original.name return false;
    for other: workspace.files[id.file].syntax.symbols.view() {
        if other.name == name && other.scope == original.scope return true;
    }
    uses: [..]bool;
    defer uses.free();
    for file: 0..workspace.files.count uses.push(false);
    for file: 0..workspace.files.count {
        if !workspace.files[file].relevant continue;
        for token: 0..workspace.files[file].semantic.bindings.count {
            if !ide_renamed_token(workspace, file, token, id) continue;
            uses[file] = true;
            if ide_member_token(workspace, file, token) continue;
            offset := workspace.files[file].syntax.language.tokens[token].start;
            if ide_name_visible(workspace, file, offset, name) return true;
        }
    }
    for file: 0..workspace.files.count {
        if !workspace.files[file].relevant continue;
        language := &workspace.files[file].syntax.language;
        for token: 0..workspace.files[file].semantic.bindings.count {
            span := language.tokens[token];
            if span.kind != 1 || span.end - span.start != name.count ||
               workspace.files[file].source.substring(span.start, span.end) != name continue;
            bound := workspace.files[file].semantic.bindings[token];
            if analysis_same_symbol(bound, id) continue;
            if ide_rename_captures(workspace, file, token, id, bound, uses.view()) return true;
        }
    }
    return false;
}

#public ide_write_rename :: (
    out: *String_Builder,
    workspace: *Workspace,
    id: Symbol_Id,
    name: str,
) {
    out.write_string("{\"changes\":{");
    documents: ssize = 0;
    for file: 0..workspace.files.count {
        if !workspace.files[file].relevant || workspace.files[file].generated ||
           ide_read_only_file(workspace, file) continue;
        count: ssize = 0;
        for token: 0..workspace.files[file].semantic.bindings.count {
            if !ide_renamed_token(workspace, file, token, id) continue;
            if count == 0 {
                if documents > 0 out.write_byte(#char ",");
                documents += 1;
                write_json_string(out, workspace.files[file].uri);
                out.write_string(":[");
            } else out.write_byte(#char ",");
            count += 1;
            span := workspace.files[file].syntax.language.tokens[token];
            out.write_string("{\"range\":");
            write_range(out, workspace.files[file].source, span.start, span.end);
            out.write_string(",\"newText\":");
            write_json_string(out, name);
            out.write_byte(#char "}");
        }
        if count > 0 out.write_byte(#char "]");
    }
    out.write_string("}}");
}

// The declaration a symbol nests under in an outline: its nearest owner
// whose range contains it, or -1 at the top level. Owners precede the
// symbols they own, so the chain ends.
#public ide_outline_parent :: (syntax: *const Parsed_File, symbol: ssize) -> ssize {
    declaration := syntax.symbols[symbol];
    parent := declaration.parent_symbol;
    while parent >= 0 && parent < symbol {
        owner := syntax.symbols[parent];
        if owner.name != "_" && owner.start <= declaration.start && declaration.end <= owner.end
            return parent;
        parent = owner.parent_symbol;
    }
    return -1;
}

ide_write_outline_symbol :: (
    out: *String_Builder, workspace: *Workspace, file: ssize, symbol: ssize,
    children: []const ssize, siblings: []const ssize,
) {
    declaration := workspace.files[file].syntax.symbols[symbol];
    source := workspace.files[file].source;
    out.write_string("{\"name\":");
    write_json_string(out, declaration.name);
    out.write_string(",\"kind\":");
    write_json_integer(out, cast(ssize)declaration.kind);
    out.write_string(",\"detail\":");
    write_json_string(out, declaration.detail);
    out.write_string(",\"range\":");
    write_range(out, source, declaration.start, declaration.end);
    out.write_string(",\"selectionRange\":");
    write_range(out, source, declaration.selection_start, declaration.selection_end);
    child := children[symbol];
    if child >= 0 {
        out.write_string(",\"children\":[");
        while child >= 0 {
            if child != children[symbol] out.write_byte(#char ",");
            ide_write_outline_symbol(out, workspace, file, child, children, siblings);
            child = siblings[child];
        }
        out.write_byte(#char "]");
    }
    out.write_byte(#char "}");
}

// Hierarchical document symbols: parameters, locals and nested declarations
// are children of the declaration around them.
#public ide_write_outline :: (
    out: *String_Builder, workspace: *Workspace, file: ssize, count: *ssize,
) {
    syntax := &workspace.files[file].syntax;
    children: [..]ssize;
    defer children.free();
    siblings: [..]ssize;
    defer siblings.free();
    parents: [..]ssize;
    defer parents.free();
    for i: 0..syntax.symbols.count {
        children.push(-1);
        siblings.push(-1);
        parents.push(ide_outline_parent(syntax, i));
    }
    // Prepend in reverse so that children stay in source order.
    i := syntax.symbols.count;
    while i > 0 {
        i -= 1;
        parent := parents[i];
        if syntax.symbols[i].name == "_" || parent < 0 continue;
        siblings[i] = children[parent];
        children[parent] = i;
    }
    for symbol: 0..syntax.symbols.count {
        if syntax.symbols[symbol].name == "_" || parents[symbol] >= 0 continue;
        if count.* > 0 out.write_byte(#char ",");
        count.* += 1;
        ide_write_outline_symbol(out, workspace, file, symbol, children.view(), siblings.view());
    }
}

#public ide_write_symbols :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    query: str,
    hierarchical: bool,
    count: *ssize,
    limit: ssize = -1,
) {
    if hierarchical && query.count == 0 {
        ide_write_outline(out, workspace, file, count);
        return;
    }
    for symbol: workspace.files[file].syntax.symbols.view() {
        if symbol.name == "_" continue;
        if query.count > 0 && !symbol.name.contains(query) continue;
        if limit >= 0 && count.* >= limit return;
        if count.* > 0 out.write_byte(#char ",");
        count.* += 1;
        out.write_string("{\"name\":");
        write_json_string(out, symbol.name);
        out.write_string(",\"kind\":");
        write_json_integer(out, cast(ssize)symbol.kind);
        if hierarchical {
            out.write_string(",\"detail\":");
            write_json_string(out, symbol.detail);
            out.write_string(",\"range\":");
            write_range(out, workspace.files[file].source, symbol.start, symbol.end);
            out.write_string(",\"selectionRange\":");
            write_range(
                out,
                workspace.files[file].source,
                symbol.selection_start,
                symbol.selection_end
            );
        } else {
            out.write_string(",\"location\":");
            ide_write_occurrence(
                out,
                workspace,
                file,
                symbol.selection_start,
                symbol.selection_end
            );
        }
        out.write_byte(#char "}");
    }
}

#public ide_completion_kind :: (kind: s32) -> ssize {
    if kind == {
        case 2;
        return 9;
        case 12;
        return 3;
        case 23;
        return 22;
        case 10;
        return 13;
        case 14;
        return 21;
        case 8;
        return 5;
        case 22;
        return 20;
        else;
        return 6;
    }
}

#public ide_completion_item :: (
    out: *String_Builder,
    source: str,
    start: ssize,
    end: ssize,
    label: str,
    detail: str,
    kind: ssize,
    count: *ssize,
    insert_text: str = "",
) {
    if count.* > 0 out.write_byte(#char ",");
    count.* += 1;
    out.write_string("{\"label\":");
    write_json_string(out, label);
    out.write_string(",\"detail\":");
    write_json_string(out, detail);
    out.write_string(",\"kind\":");
    write_json_integer(out, kind);
    out.write_string(",\"textEdit\":{\"range\":");
    write_range(out, source, start, end);
    out.write_string(",\"newText\":");
    if insert_text.count > 0 write_json_string(out, insert_text);
    else write_json_string(out, label);
    out.write_string("}}");
}

#public ide_write_import_completion :: (
    out: *String_Builder, workspace: *Workspace, file: ssize, offset: ssize,
) -> bool {
    syntax := &workspace.files[file].syntax;
    source := workspace.files[file].source;
    for dependency: syntax.imports.view() {
        if dependency.embedded && !dependency.load continue;
        quoted := dependency.path_token >= 0;
        start := offset;
        end := start;
        needs_space := false;
        if quoted {
            token := syntax.language.tokens[dependency.path_token];
            if source[token.start] != #char "\"" continue;
            start = token.start + 1;
            end = start;
            // Stop unfinished paths at the line boundary so an edit cannot swallow later code.
            while end < token.end {
                if source[end] == #char "\"" || source[end] == #char "\n" ||
                   source[end] == #char "\r" break;
                if source[end] == #char "\\" && end + 1 < token.end end += 1;
                end += 1;
            }
        } else {
            directive := language_token_at(&syntax.language, dependency.start);
            if directive < 0 continue;
            after := syntax.language.tokens[directive].end;
            if offset < after continue;
            needs_space = offset == after;
            while after < offset && (source[after] == #char " " || source[after] == #char "\t")
                after += 1;
            if after != offset continue;
        }
        if offset < start || offset > end continue;
        // `#export "Module"` names a module like `#import`; only `#load` takes a file.
        paths := workspace_complete_import(workspace, file, source[start..offset],
            dependency.load);
        defer {
            for path: paths.paths.view() path.free();
            paths.paths.free();
        }
        if paths.incomplete out.write_string("{\"isIncomplete\":true,\"items\":[");
        else out.write_string("{\"isIncomplete\":false,\"items\":[");
        count: ssize = 0;
        for path: paths.paths.view() {
            kind: ssize = 9;
            detail := "Glosso module";
            if dependency.load || workspace_source_import(source[start..offset]) {
                kind = 17;
                detail = "Glosso source file";
            }
            if path.ends_with("/") {
                kind = 19;
                detail = "Directory";
            }
            escaped: String_Builder;
            defer escaped.free();
            if needs_space escaped.write_byte(#char " ");
            if !quoted escaped.write_byte(#char "\"");
            for byte: path.bytes() {
                if byte == {
                    case #char "\\"; escaped.write_string("\\\\");
                    case #char "\""; escaped.write_string("\\\"");
                    case #char "\n"; escaped.write_string("\\n");
                    case #char "\r"; escaped.write_string("\\r");
                    case #char "\t"; escaped.write_string("\\t");
                    else; escaped.write_byte(byte);
                }
            }
            if !quoted escaped.write_byte(#char "\"");
            ide_completion_item(out, source, start, end, path, detail, kind, &count,
                escaped.to_string());
        }
        out.write_string("]}");
        return true;
    }
    return false;
}

// Whether `source[at]` is a member-access dot rather than part of `..`,
// `..=` or `...`.
#public ide_member_dot :: (source: str, at: ssize) -> bool {
    if at < 0 || at >= source.count || source[at] != #char "." return false;
    return at == 0 || source[at - 1] != #char ".";
}

#public ide_write_completion :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    offset: ssize,
) {
    if ide_write_import_completion(out, workspace, file, offset) return;
    syntax := &workspace.files[file].syntax;
    source := workspace.files[file].source;
    start := offset;
    end := offset;
    index := language_token_at(&syntax.language, offset);
    if index < 0 && offset > 0 {
        previous := language_token_at(&syntax.language, offset - 1);
        if previous >= 0 {
            token := syntax.language.tokens[previous];
            text := source[token.start..token.end];
            if token.kind == {
                case 1, 5, 7;
                index = previous;
                case 4;
                if text.starts_with("//") || !text.ends_with("*/") index = previous;
                case 3;
                {
                    if text.starts_with("\\\\") index = previous;
                } else;
            }
            if token.kind == 3 || token.kind == 4 {
                for diagnostic: syntax.language.diagnostics.view() {
                    if diagnostic.start == token.start index = previous;
                }
            }
        }
    }
    if workspace.files[file].compiler_epoch != workspace.compiler_epoch
        out.write_string("{\"isIncomplete\":true,\"items\":[");
    else out.write_string("{\"isIncomplete\":false,\"items\":[");
    if index >= 0 {
        token := syntax.language.tokens[index];
        if token.kind == 3 || token.kind == 4 {
            out.write_string("]}");
            return;
        }
        if token.kind == 1 || token.kind == 5 || token.kind == 7 {
            start = token.start;
            end = token.end;
        }
    }
    prefix := source[start..offset];
    dot := start - 1;
    while dot >= 0 && (source[dot] == #char " " || source[dot] == #char "\t") dot -= 1;
    member := ide_member_dot(source, dot);
    candidates: [..]Symbol_Id;
    defer candidates.free();
    if member _ := candidates.replace(analysis_members_at(workspace, file, offset));
    else _ := candidates.replace(analysis_visible_symbols(workspace, file, offset));
    count: ssize = 0;
    for id: candidates.view() {
        if !ide_valid_symbol(workspace, id) continue;
        symbol := workspace.files[id.file].syntax.symbols[id.symbol];
        if !symbol.name.starts_with(prefix) continue;
        detail: String_Builder;
        defer detail.free();
        detail.write_string(symbol.name);
        detail.write_string(": ");
        fact := workspace_compiler_fact(workspace, id.file, symbol.selection_start, 1);
        if symbol.kind == 13 && fact.type_name.count > 0 detail.write_string(fact.type_name);
        else analysis_write_type(&detail, workspace, analysis_type(workspace, id));
        ide_completion_item(
            out,
            source,
            start,
            end,
            symbol.name,
            detail.to_string(),
            ide_completion_kind(symbol.kind),
            &count
        );
    }
    if !member {
        words :: .[
            "if",
            "ifx",
            "else",
            "while",
            "for",
            "return",
            "break",
            "continue",
            "struct",
            "union",
            "enum",
            "case",
            "using",
            "defer",
            "context",
            "cast",
            "acast",
            "where",
            "noalias",
            "typeclass",
            "instance",
            "distinct",
            "opaque",
        ];
        for word: words {
            if word.starts_with(prefix) ide_completion_item(
                out,
                source,
                start,
                end,
                word,
                language_keyword_detail(word),
                14,
                &count
            );
        }
        for word: language_builtin_types {
            if word.starts_with(prefix)
                ide_completion_item(out, source, start, end, word, "Glosso built-in", 14, &count);
        }
        for word: .["true", "false"] {
            if word.starts_with(prefix)
                ide_completion_item(out, source, start, end, word, "Glosso built-in", 14, &count);
        }
        directives :: .[
            "#import",
            "#module_params",
            "#export",
            "#public",
            "#private",
            "#comptime",
            "#if",
            "#assert",
            "#pattern",
            "#insert",
            "#string",
            "#char",
            "#matrix",
            "#derive",
            "#simd",
            "#self",
            "#Self_Type",
            "#on_drop_error",
            "#enable",
            "#c_call",
            "#library",
        ];
        for word: directives {
            if word.starts_with(prefix) ide_completion_item(
                out,
                source,
                start,
                end,
                word,
                "Glosso compiler directive",
                14,
                &count
            );
        }
    }
    out.write_string("]}");
}

#public ide_write_inlay_hints :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    start: ssize,
    end: ssize,
) {
    out.write_byte(#char "[");
    count: ssize = 0;
    for i: 0..workspace.files[file].syntax.symbols.count {
        symbol := workspace.files[file].syntax.symbols[i];
        if symbol.name == "_" continue;
        if symbol.kind != 13 || symbol.type_node >= 0 || symbol.value_node < 0 ||
            symbol.selection_end < start || symbol.selection_end > end continue;
        ty := analysis_type(workspace, .{ .file = file, .symbol = i });
        fact := workspace_compiler_fact(workspace, file, symbol.selection_start, 1);
        if ty <= 0 && fact.type_name.count == 0 continue;
        label: String_Builder;
        defer label.free();
        label.write_string(": ");
        if fact.type_name.count > 0 label.write_string(fact.type_name);
        else analysis_write_type(&label, workspace, ty);
        if count > 0 out.write_byte(#char ",");
        count += 1;
        out.write_string("{\"position\":");
        write_position(out, position_at(workspace.files[file].source, symbol.selection_end));
        out.write_string(",\"kind\":1,\"label\":");
        write_json_string(out, label.to_string());
        out.write_byte(#char "}");
    }
    out.write_byte(#char "]");
}

#public ide_write_links :: (out: *String_Builder, workspace: *Workspace, file: ssize) {
    out.write_byte(#char "[");
    count: ssize = 0;
    for edge: workspace.files[file].imports.view() {
        if edge.target < 0 continue;
        item := workspace.files[file].syntax.imports[edge.declaration];
        if count > 0 out.write_byte(#char ",");
        count += 1;
        out.write_string("{\"range\":");
        write_range(out, workspace.files[file].source, item.start, item.end);
        out.write_string(",\"target\":");
        write_json_string(out, workspace.files[edge.target].uri);
        out.write_byte(#char "}");
    }
    out.write_byte(#char "]");
}

#public ide_write_selection :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    offset: ssize,
) {
    syntax := &workspace.files[file].syntax;
    source := workspace.files[file].source;
    best: ssize = -1;
    size := source.count + 1;
    for i: 0..syntax.nodes.count {
        node := syntax.nodes[i];
        if node.start <= offset && offset <= node.end && node.end - node.start < size {
            best = i;
            size = node.end - node.start;
        }
    }
    depth: ssize = 0;
    previous_start: ssize = -1;
    previous_end: ssize = -1;
    token_index := language_token_at(&syntax.language, offset);
    if token_index >= 0 {
        token := syntax.language.tokens[token_index];
        out.write_string("{\"range\":");
        write_range(out, source, token.start, token.end);
        previous_start = token.start;
        previous_end = token.end;
        depth = 1;
    }
    while best >= 0 && depth < 64 {
        node := syntax.nodes[best];
        if (node.start != previous_start || node.end != previous_end) &&
           (previous_start < 0 || (node.start <= previous_start && node.end >= previous_end)) {
            if depth > 0 out.write_string(",\"parent\":");
            out.write_string("{\"range\":");
            write_range(out, source, node.start, node.end);
            previous_start = node.start;
            previous_end = node.end;
            depth += 1;
        }
        parent := node.parent;
        if parent == best break;
        best = parent;
    }
    if depth == 0 {
        out.write_string("{\"range\":");
        write_range(out, source, offset, offset);
        depth = 1;
    }
    for 0..depth out.write_byte(#char "}");
}

// The `(` that opens a call's arguments, or -1.
#public ide_call_open :: (syntax: *const Parsed_File, call: ssize) -> ssize {
    callee := syntax.nodes[call].left;
    if callee < 0 return -1;
    end := syntax.nodes[callee].end;
    token := language_token_at(&syntax.language, end);
    if token < 0 {
        token = 0;
        while token < syntax.language.tokens.count && syntax.language.tokens[token].start < end
            token += 1;
    }
    if token >= syntax.language.tokens.count return -1;
    span := syntax.language.tokens[token];
    if syntax.source.substring(span.start, span.end) != "(" return -1;
    return token;
}

// Whether `offset` is between a call's parentheses. An unclosed call extends
// over the whitespace after it, such as at the end of the file while typing.
#public ide_inside_arguments :: (
    syntax: *const Parsed_File, source: str, call: ssize, offset: ssize,
) -> bool {
    open := ide_call_open(syntax, call);
    if open < 0 return false;
    opening := syntax.language.tokens[open];
    if offset < opening.end return false;
    if opening.matching > open return offset <= syntax.language.tokens[opening.matching].start;
    end := syntax.nodes[call].end;
    while end < offset && end < source.count && (source[end] == #char " " ||
          source[end] == #char "\t" || source[end] == #char "\n" || source[end] == #char "\r")
        end += 1;
    return offset <= end;
}

#public ide_write_signature_help :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    offset: ssize,
) {
    syntax := &workspace.files[file].syntax;
    source := workspace.files[file].source;
    call: ssize = -1;
    for i: 0..syntax.nodes.count {
        node := syntax.nodes[i];
        if node.kind != .Call || node.left < 0 || node.start > offset continue;
        if !ide_inside_arguments(syntax, source, i, offset) continue;
        if call < 0 || node.start >= syntax.nodes[call].start call = i;
    }
    if call < 0 {
        out.write_string("null");
        return;
    }
    callee := syntax.nodes[call].left;
    at := syntax.nodes[callee].end - 1;
    id := analysis_symbol_at(workspace, file, at);
    if !ide_valid_symbol(workspace, id) {
        out.write_string("null");
        return;
    }
    symbol := workspace.files[id.file].syntax.symbols[id.symbol];
    if symbol.kind != 12 {
        out.write_string("null");
        return;
    }
    declaration := &workspace.files[id.file].syntax;
    procedure := symbol.value_node;
    if procedure < 0 || declaration.nodes[procedure].kind != .Procedure procedure = symbol.node;
    active: ssize = 0;
    token := ide_call_open(syntax, call) + 1;
    while token < syntax.language.tokens.count && syntax.language.tokens[token].start < offset {
        item := syntax.language.tokens[token];
        text := workspace.files[file].source[item.start..item.end];
        if text == "," active += 1;
        if item.matching > token token = item.matching;
        token += 1;
    }
    active += analysis_call_receiver_offset(workspace, file, callee, analysis_type(workspace, id));
    out.write_string("{\"activeSignature\":0,\"activeParameter\":");
    count: ssize = 0;
    if procedure >= 0 {
        parameter := declaration.nodes[procedure].first_child;
        while parameter >= 0 {
            if declaration.nodes[parameter].kind == .Parameter count += 1;
            parameter = declaration.nodes[parameter].next_sibling;
        }
    }
    if count > 0 && active >= count active = count - 1;
    write_json_integer(out, active);
    out.write_string(",\"signatures\":[{\"label\":");
    write_json_string(out, symbol.detail);
    out.write_string(",\"parameters\":[");
    count = 0;
    if procedure >= 0 {
        parameter := declaration.nodes[procedure].first_child;
        while parameter >= 0 {
            item := declaration.nodes[parameter];
            if item.kind == .Parameter && item.symbol >= 0 {
                if count > 0 out.write_byte(#char ",");
                count += 1;
                out.write_string("{\"label\":");
                write_json_string(out, declaration.symbols[item.symbol].detail);
                out.write_byte(#char "}");
            }
            parameter = item.next_sibling;
        }
    }
    out.write_string("]}]}");
}

#public ide_spelling_distance :: (left: str, right: str) -> ssize {
    if left.count - right.count > 2 || right.count - left.count > 2 return 3;
    previous: [..]ssize;
    defer previous.free();
    current: [..]ssize;
    defer current.free();
    for i: 0..right.count + 1 {
        previous.push(i);
        current.push(0);
    }
    for row: 1..left.count + 1 {
        current[0] = row;
        for column: 1..right.count + 1 {
            substitution := previous[column - 1];
            if left[row - 1] != right[column - 1]substitution += 1;
            value := previous[column] + 1;
            if current[column - 1] + 1 < value value = current[column - 1] + 1;
            if substitution < value value = substitution;
            current[column] = value;
        }
        for column: 0..right.count + 1 previous[column] = current[column];
    }
    return previous[right.count];
}

// Whether a document lives only in the editor. An `untitled:` buffer has an
// overlay path in the temporary directory, which no import may name.
#public ide_path_less :: (workspace: *Workspace, file: ssize) -> bool {
    return !workspace.files[file].uri.starts_with("file:");
}

// How `file` imports `target`: by module name for the standard library and
// import paths, otherwise by a path relative to `file`.
#public ide_import_name :: (workspace: *Workspace, file: ssize, target: ssize) -> ?str {
    if ide_path_less(workspace, target) return null;
    path := workspace.files[target].path;
    for i: 0..1 + workspace.import_paths.count {
        root := workspace_module_root(workspace, i);
        if root.count == 0 || !path_lexically_contains(root, path) continue;
        // Only a module's entry file is importable by name; files it loads are not.
        if path_lexically_relative(path, root) == {
            case .Err; return null;
            case .Ok(relative);
                defer relative.free();
                name: str = relative;
                if name.ends_with("/module.glo") name = name.substring(0, name.count - 11);
                else if name.ends_with(".glo") name = name.substring(0, name.count - 4);
                else return null;
                found, conflict := workspace_find_module(workspace, name);
                defer found.free();
                if conflict || found != path return null;
                return ?name.clone();
        }
    }
    // A relative import from an untitled buffer would resolve in the temporary directory.
    if ide_path_less(workspace, file) return null;
    base := path_dirname(workspace.files[file].path);
    if path_lexically_relative(path, base) == {
        case .Ok(relative); return ?relative;
        case .Err; return null;
    }
}

#public ide_write_code_actions :: (
    out: *String_Builder,
    workspace: *Workspace,
    file: ssize,
    range: ?*Json,
) {
    source := workspace.files[file].source;
    start := json_offset(source, json_field(range, "start"));
    end := json_offset(source, json_field(range, "end"));
    count: ssize = 0;
    out.write_byte(#char "[");
    for diagnostic: workspace.files[file].semantic.diagnostics.view() {
        if diagnostic.start > end || diagnostic.end < start continue;
        if !diagnostic.message.starts_with("Unresolved") &&
            !diagnostic.message.starts_with("Unknown") continue;
        token := language_token_at(&workspace.files[file].syntax.language, diagnostic.start);
        if token < 0 continue;
        span := workspace.files[file].syntax.language.tokens[token];
        misspelled := source[span.start..span.end];
        visible: [..]Symbol_Id;
        defer visible.free();
        if ide_member_dot(source, span.start - 1)
            _ := visible.replace(analysis_members_at(workspace, file, span.start));
        else _ := visible.replace(analysis_visible_symbols(workspace, file, span.start));
        for candidate: visible.view() {
            symbol := workspace.files[candidate.file].syntax.symbols[candidate.symbol];
            if symbol.name == misspelled || ide_spelling_distance(
                misspelled,
                symbol.name
            ) > 2 continue;
            if count > 0 out.write_byte(#char ",");
            count += 1;
            title := tprint("Change '{}' to '{}'", misspelled, symbol.name);
            out.write_string("{\"kind\":\"quickfix\",\"title\":");
            write_json_string(out, title);
            out.write_string(",\"edit\":{\"changes\":{");
            write_json_string(out, workspace.files[file].uri);
            out.write_string(":[{\"range\":");
            write_range(out, source, span.start, span.end);
            out.write_string(",\"newText\":");
            write_json_string(out, symbol.name);
            out.write_string("}]}}}");
            if count >= 10 break;
        }
        for target: 0..workspace.files.count {
            if target == file || !workspace.files[target].relevant continue;
            // A generated file is a cache artifact: import the file whose #insert made it.
            owner := target;
            if workspace.files[target].generated owner = workspace.files[target].generated_origin;
            if owner < 0 || owner == file || workspace.files[owner].generated continue;
            imported := false;
            for edge: workspace.files[file].imports.view() {
                if edge.target == owner imported = true;
            }
            if imported continue;
            for symbol: workspace.files[target].syntax.symbols.view() {
                if symbol.scope != 0 || !symbol.is_public || symbol.name != misspelled continue;
                if #pattern ?path = ide_import_name(workspace, file, owner) {
                    defer path.free();
                    insertion: String_Builder;
                    defer insertion.free();
                    insertion.write_string("#import ");
                    write_json_string(&insertion, path);
                    insertion.write_string(";\n");
                    if count > 0 out.write_byte(#char ",");
                    count += 1;
                    out.write_string("{\"kind\":\"quickfix\",\"title\":");
                    write_json_string(out, tprint("Import '{}' from '{}'", misspelled, path));
                    out.write_string(",\"edit\":{\"changes\":{");
                    write_json_string(out, workspace.files[file].uri);
                    out.write_string(":[{\"range\":");
                    write_range(out, source, 0, 0);
                    out.write_string(",\"newText\":");
                    write_json_string(out, insertion.to_string());
                    out.write_string("}]}}}");
                }
            }
        }
    }
    out.write_byte(#char "]");
}
