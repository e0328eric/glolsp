#load "../src/layout.glo";
#import "Io";
#import "Strings";

main :: () {
    source := "main :: () {value:=1;other:=value;}";
    formatted := layout_format(source);
    defer formatted.free();
    #assert formatted == #string
        \\main :: () {
        \\    value := 1;
        \\    other := value;
        \\}
        \\
    ;
    again := layout_format(formatted);
    defer again.free();
    #assert again == formatted;
    tabs := layout_format(source, 4, false);
    defer tabs.free();
    #assert tabs.contains("\n\tvalue");
    text := #string
        \\main :: () {
        \\    string := "{ ; // not code }";
        \\    byte := #char "}";
        \\    /* outer /* inner */ comment */
        \\    raw := #string
        \\        \\\\  { raw; unchanged }
        \\    ;
        \\}
    ;
    literals := layout_format(text);
    defer literals.free();
    #assert literals.contains("\"{ ; // not code }\"");
    #assert literals.contains("/* outer /* inner */ comment */");
    current := #string
        \\main :: () {
        \\    #memory,trusted { m:Matrix(f64,2,2)=#matrix .[1,2;3,4]; }
        \\    print("{0:x} {{literal}} 100% {:c}", 65);
        \\}
    ;
    current_layout := layout_format(current);
    defer current_layout.free();
    #assert current_layout.contains("#matrix .[1, 2; 3, 4]");
    #assert current_layout.contains("\"{0:x} {{literal}} 100% {:c}\"");
    current_again := layout_format(current_layout);
    defer current_again.free();
    #assert current_again == current_layout;
    malformed := "main :: () { /* never closed";
    unchanged := layout_format(malformed);
    defer unchanged.free();
    #assert malformed == unchanged;
    print("layout tests passed\n");
}
