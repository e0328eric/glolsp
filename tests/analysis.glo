#import "../src/analysis.glo";
#import "../src/model.glo";
#import "../src/workspace.glo";
#import "Io";
#import "String_Builder";

find_text :: (text: str, needle: str, from: ssize = 0) -> ssize {
    for at: from..text.count - needle.count + 1 {
        if text.substring(at, at + needle.count) == needle return at;
    }
    return -1;
}

symbol_named :: (workspace: *const Workspace, file: ssize, name: str) -> Symbol_Id {
    for i: 0..workspace.files[file].syntax.symbols.count {
        if workspace.files[file].syntax.symbols[i].name == name
            return .{ .file = file, .symbol = i };
    }
    return .{};
}

type_text :: (workspace: *Workspace, symbol: Symbol_Id) -> str {
    out: String_Builder;
    analysis_write_type(&out, workspace, analysis_type(workspace, symbol));
    return out.into_string();
}

check_slice_types :: () {
    for bounds: .["start..end", "start..=end", "start..", "..end", "..=end", "..",
                  "(start..end)", "..(end + 1)", "..=(end + 1)"] {
        generated: String_Builder;
        generated.write_string(#string
            \\Point :: struct { x: ssize; }
            \\take_text :: (value: str) {}
            \\take_wide :: (value: string16) {}
            \\take_points :: (value: []Point) {}
            \\main :: () {
            \\    source := "hello"; wide: string16; values: [4]Point;
            \\    start: ssize = 0; end: ssize = 2;
        );
        for name: .["source", "wide", "values"] {
            generated.write_string(name);
            generated.write_string("_slice := ");
            generated.write_string(name);
            generated.write_string("[");
            generated.write_string(bounds);
            generated.write_string("];\n");
        }
        generated.write_string(#string
            \\    take_text(source_slice); take_wide(wide_slice); take_points(values_slice);
            \\    source_byte := source[0]; wide_unit := wide[0]; point := values[0];
            \\    point.x; values_slice[0].x;
            \\    take_text(source[0]); take_points(values[0]);
            \\}
        );
        source := generated.into_string();
        defer source.free();
        workspace: Workspace;
        defer workspace_destroy(&workspace);
        file := workspace_open(&workspace, "file:///tmp/glolsp-analysis/slices.glo", source, 1);
        analyze_workspace(&workspace);
        #assert workspace.files[file].syntax.language.diagnostics.count == 0;
        #assert workspace.files[file].semantic.diagnostics.count == 2;
        for name: .["source_slice", "wide_slice", "values_slice", "source_byte", "wide_unit"] {
            inferred := type_text(&workspace, symbol_named(&workspace, file, name));
            defer inferred.free();
            expected := "str";
            if name == {
                case "wide_slice"; expected = "string16";
                case "values_slice"; expected = "[]Point";
                case "source_byte"; expected = "u8";
                case "wide_unit"; expected = "u16";
                else; {}
            }
            if inferred != expected print("{}[{}]: expected {}, got {}\n", name, bounds,
                expected, inferred);
            #assert inferred == expected;
        }
        x := symbol_named(&workspace, file, "x");
        for access: .["point.x", "values_slice[0].x"] {
            #assert analysis_same_symbol(analysis_symbol_at(&workspace, file,
                find_text(source, access) + access.count - 1), x);
        }
    }
}

check_variadic_types :: () {
    source := #string
        \\Point :: struct { x: ssize; }
        \\Child :: struct { point: Point; }
        \\take_parts :: (parts: []const str) {}
        \\join :: (parts: ...str) {
        \\    take_parts(parts);
        \\    copied := parts; first := parts[0]; count := parts.count;
        \\    join(parts...);
        \\}
        \\identity :: (items: ...$T) -> T { return items[0]; }
        \\pick :: (values: ...str) -> Point { result: Point; return result; }
        \\pick :: (values: ...bool) -> Child { result: Child; return result; }
        \\main :: () {
        \\    strings: []const str; flags: []bool; points: []Point; point: Point;
        \\    direct := identity(point); spread := identity(points...);
        \\    direct.x; spread.x;
        \\    text := pick("one", "two"); texts := pick(strings...);
        \\    flag := pick(true, false); bools := pick(flags...);
        \\    text.x; texts.x; flag.point.x; bools.point.x;
        \\    join(); join("one", "two"); join(strings...);
        \\}
    ;
    workspace: Workspace;
    defer workspace_destroy(&workspace);
    file := workspace_open(&workspace, "file:///tmp/glolsp-analysis/variadic-types.glo", source, 1);
    analyze_workspace(&workspace);
    #assert workspace.files[file].syntax.language.diagnostics.count == 0;
    #assert workspace.files[file].semantic.diagnostics.count == 0;
    for name: .["copied", "first", "count", "direct", "spread", "text", "texts", "flag", "bools"] {
        inferred := type_text(&workspace, symbol_named(&workspace, file, name));
        defer inferred.free();
        expected := "Point";
        if name == {
            case "copied"; expected = "[]str";
            case "first"; expected = "str";
            case "count"; expected = "ssize";
            case "flag", "bools"; expected = "Child";
            else;
        }
        if inferred != expected print("{}: expected {}, got {}\n", name, expected, inferred);
        #assert inferred == expected;
    }
}

check_matrix_types :: () {
    workspace: Workspace;
    defer workspace_destroy(&workspace);
    source := #string
        \\Rows :: 2;
        \\M :: Matrix(f64, Rows, 2);
        \\read :: (value: M) -> f64 { return value[0, 1]; }
        \\make :: () -> M { return #matrix .[1, 2; 3, 4]; }
        \\main :: () {
        \\    element: f64 = 1;
        \\    value: M = #matrix .[element, 2; 3, 4];
        \\    inferred := make();
        \\    indexed := value[1, 0];
        \\    empty: Matrix(f64, 2, 0) = #matrix .[];
        \\    value = #matrix .[1, 2; 3, 4];
        \\    read(#matrix .[1, 2; 3, 4]);
        \\}
    ;
    file := workspace_open(&workspace, "file:///tmp/glolsp-matrix.glo", source, 1);
    analyze_workspace(&workspace);
    #assert workspace.files[file].syntax.language.diagnostics.count == 0;
    #assert workspace.files[file].semantic.diagnostics.count == 0;
    inferred := type_text(&workspace, symbol_named(&workspace, file, "inferred"));
    defer inferred.free();
    #assert inferred == "Matrix(f64, 2, 2)";
    indexed := type_text(&workspace, symbol_named(&workspace, file, "indexed"));
    defer indexed.free();
    #assert indexed == "f64";
    element := symbol_named(&workspace, file, "element");
    #assert analysis_same_symbol(element, analysis_symbol_at(&workspace, file,
        find_text(source, "[element") + 1));

    invalid := #string
        \\main :: () {
        \\    size: Matrix(ssize, 2, 2) = #matrix .[1, 2];
        \\    item: Matrix(ssize, 1, 1) = #matrix .[true];
        \\    ordinary: Matrix(ssize, 1, 2) = .[1, 2];
        \\    scalar: ssize = #matrix .[1];
        \\    #memory,trusted { missing; }
        \\}
    ;
    _ := workspace_open(&workspace, "file:///tmp/glolsp-matrix.glo", invalid, 2);
    analyze_workspace(&workspace);
    #assert workspace.files[file].syntax.language.diagnostics.count == 0;
    #assert workspace.files[file].semantic.diagnostics.count == 5;
}

// Long left-nested chains once overflowed the main thread's stack.
check_deep_chains :: () {
    generated: String_Builder;
    generated.write_string("Node :: struct { next: *Node; }\nmain :: () {\n    a := 1; node: Node;\n    sum := a");
    for 0..6000 generated.write_string(" + a");
    generated.write_string(";\n    last := node");
    for 0..6000 generated.write_string(".next");
    generated.write_string(";\n    nested := (((((((((((((((((((((((((((((((a)))))))))))))))))))))))))))))));\n}\n");
    source := generated.into_string();
    defer source.free();
    workspace: Workspace;
    defer workspace_destroy(&workspace);
    file := workspace_open(&workspace, "file:///tmp/glolsp-analysis/deep.glo", source, 1);
    analyze_workspace(&workspace);
    for name: .["sum", "last", "nested"] {
        inferred := type_text(&workspace, symbol_named(&workspace, file, name));
        defer inferred.free();
        expected := "ssize";
        if name == "last" expected = "*Node";
        if inferred != expected print("{}: expected {}, got {}\n", name, expected, inferred);
        #assert inferred == expected;
    }
    a := symbol_named(&workspace, file, "a");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, file,
        find_text(source, "sum := a") + 7), a);
}

// Local procedures are not closures, initializers read the outer binding,
// and uses of an alias stay bound to the alias.
check_scoping :: () {
    source := #string
        \\a :: "global";
        \\f :: (pp: s32) -> s32 {
        \\    a: s32 = 1;
        \\    K :: 3;
        \\    Local :: struct { field: s32; }
        \\    helper :: () -> s32 { return 4; }
        \\    inner :: () -> str { b := pp; c := K; d := helper(); e: Local; return a; }
        \\    x: str = "abc";
        \\    {
        \\        x := x.count;
        \\        y := x;
        \\    }
        \\    return a;
        \\}
        \\foo :: (v: s32) -> s32 { return v; }
        \\alias :: foo;
        \\main :: () -> s32 { return alias(1) + foo(2); }
    ;
    workspace: Workspace;
    defer workspace_destroy(&workspace);
    file := workspace_open(&workspace, "file:///tmp/glolsp-analysis/scoping.glo", source, 1);
    analyze_workspace(&workspace);
    #assert workspace.files[file].syntax.language.diagnostics.count == 0;
    at :: (workspace: *Workspace, file: ssize, source: str, needle: str, delta: ssize = 0) -> Symbol_Id {
        return analysis_symbol_at(workspace, file, find_text(source, needle) + delta);
    }
    global := at(&workspace, file, source, "a ::");
    local := at(&workspace, file, source, "a: s32");
    #assert !analysis_same_symbol(global, local);
    #assert analysis_same_symbol(at(&workspace, file, source, "a; }", 0), global);
    #assert analysis_same_symbol(at(&workspace, file, source, "a;\n}"), local);
    #assert at(&workspace, file, source, "pp; c").symbol < 0;
    #assert at(&workspace, file, source, "K; d").symbol < 0;
    #assert analysis_same_symbol(at(&workspace, file, source, "helper(); e"),
        at(&workspace, file, source, "helper ::"));
    #assert analysis_same_symbol(at(&workspace, file, source, "Local; return"),
        at(&workspace, file, source, "Local ::"));
    outer := at(&workspace, file, source, "x: str");
    inner := at(&workspace, file, source, "x := x");
    #assert !analysis_same_symbol(outer, inner);
    #assert analysis_same_symbol(at(&workspace, file, source, "x.count"), outer);
    #assert analysis_same_symbol(at(&workspace, file, source, "x;\n    }"), inner);
    #assert analysis_same_symbol(at(&workspace, file, source, "alias(1)"),
        at(&workspace, file, source, "alias ::"));
    #assert analysis_same_symbol(at(&workspace, file, source, "foo(2)"),
        at(&workspace, file, source, "foo ::"));
    // A cursor just after a name still names it.
    #assert analysis_same_symbol(at(&workspace, file, source, "(1) +"), at(&workspace, file, source, "alias ::"));
    visible := analysis_visible_symbols(&workspace, file, find_text(source, "pp; c"));
    defer visible.free();
    for id: visible.view() {
        name := workspace.files[id.file].syntax.symbols[id.symbol].name;
        #assert name != "pp" && name != "K";
    }
}

// The symbol index must list exactly what a scan of every symbol finds, and a
// stale index must fall back to that scan.
check_symbol_index :: () {
    source := #string
        \\Show :: typeclass (T: type) { show :: (value: T) -> str; }
        \\Point :: struct { x: s32; y: s32; }
        \\x :: 1;
        \\f :: (x: s32, y: s32) -> s32 {
        \\    total := x + y;
        \\    { x := total; y := x; total := y; }
        \\    inner :: (x: s32) -> s32 { return x; }
        \\    return total + inner(x);
        \\}
        \\main :: () -> s32 { point: Point; return f(point.x, point.y) + x; }
    ;
    workspace: Workspace;
    defer workspace_destroy(&workspace);
    file := workspace_open(&workspace, "file:///tmp/glolsp-analysis/index.glo", source, 1);
    analyze_workspace(&workspace);
    syntax := &workspace.files[file].syntax;
    index := &workspace.files[file].semantic.index;
    #assert symbol_index_ready(index, syntax);
    #assert index.typeclasses.count == 1;
    for i: 0..syntax.symbols.count {
        symbol := syntax.symbols[i];
        scoped: [..]ssize;
        defer scoped.free();
        named: [..]ssize;
        defer named.free();
        in_scope: [..]ssize;
        defer in_scope.free();
        for j: 0..syntax.symbols.count {
            other := syntax.symbols[j];
            if other.name == symbol.name {
                named.push(j);
                if other.scope == symbol.scope scoped.push(j);
            }
            if other.scope == symbol.scope in_scope.push(j);
        }
        at := 0;
        k := symbol_index_scoped(index, syntax, symbol.scope, symbol.name, -1);
        while k >= 0 {
            #assert at < scoped.count && scoped[at] == k;
            at += 1;
            k = symbol_index_scoped(index, syntax, symbol.scope, symbol.name, k);
        }
        #assert at == scoped.count;
        at = 0;
        k = symbol_index_named(index, syntax, symbol.name, -1);
        while k >= 0 {
            #assert at < named.count && named[at] == k;
            at += 1;
            k = symbol_index_named(index, syntax, symbol.name, k);
        }
        #assert at == named.count;
        #assert symbol_index_count(index, syntax, symbol.scope) == in_scope.count;
        for position: 0..in_scope.count
            #assert symbol_index_at(index, syntax, symbol.scope, position) == in_scope[position];
    }
    resolved: [..]Symbol_Id;
    defer resolved.free();
    for node: syntax.nodes.view() {
        if node.kind != .Identifier continue;
        name := source.substring(syntax.language.tokens[node.token].start,
            syntax.language.tokens[node.token].end);
        resolved.push(analysis_lookup(&workspace, file, node.scope, name, node.start));
    }
    symbol_index_free(index);
    #assert !symbol_index_ready(index, syntax);
    at := 0;
    for node: syntax.nodes.view() {
        if node.kind != .Identifier continue;
        name := source.substring(syntax.language.tokens[node.token].start,
            syntax.language.tokens[node.token].end);
        found := analysis_lookup(&workspace, file, node.scope, name, node.start);
        #assert found.file == resolved[at].file && found.symbol == resolved[at].symbol;
        at += 1;
    }
}

main :: () {
    check_symbol_index();
    check_deep_chains();
    check_scoping();
    check_matrix_types();
    check_slice_types();
    check_variadic_types();
    workspace: Workspace;
    defer workspace_destroy(&workspace);
    source := #string
        \\Point :: struct { x: ssize; y: ssize; }
        \\Child :: struct { point: Point; }
        \\Alias :: Point;
        \\Box :: struct { value: $T; }
        \\Container :: struct($T: type) { value: T; }
        \\Option :: union($T: type) { Some(T); None; }
        \\Result :: union($E: type, $T: type) { Ok(T); Err(E); }
        \\Style :: enum { Native; Unix; }
        \\join :: (parts: ...str, style: Style = .Native) -> str { return ""; }
        \\pick :: (parts: ...str, flag: bool = false) -> Point { result: Point; return result; }
        \\pick :: (flag: bool) -> Child { result: Child; return result; }
        \\identity :: (value: $T) -> T { return value; }
        \\make :: () -> Point { return .{ .x = 1, .y = 2 }; }
        \\pair :: () -> (Point, Child) { point: Point; child: Child; return point, child; }
        \\select :: (value: str) -> Child { result: Child; return result; }
        \\select :: (value: s64) -> Point { return make(); }
        \\Point ::: #public {
        \\    read :: (#self) -> ssize { return #self.x; }
        \\}
        \\main :: () {
        \\    point: Alias = .{ .x = 1, .y = 2 };
        \\    child: Child;
        \\    child.point.x;
        \\    inferred := make();
        \\    inferred.x;
        \\    generic := identity(point);
        \\    generic.x;
        \\    boxed: Box(Point);
        \\    boxed.value.x;
        \\    container: Container(Point);
        \\    container.value.x;
        \\    text := "hello";
        \\    length := text.count;
        \\    joined := join("one", "two", "three", .style = Style.Unix);
        \\    picked := pick("one", "two");
        \\    picked.x;
        \\    optional: ?Point;
        \\    if #pattern ?payload = optional { payload.x; }
        \\    outcome: str!Point;
        \\    if #pattern .Ok(success) = outcome { success.x; }
        \\    first, second := pair();
        \\    first.x;
        \\    second.point.x;
        \\    number: s64 = 1;
        \\    chosen := select(number);
        \\    chosen.x;
        \\    point.read();
        \\    shadow := point;
        \\    { shadow: Child; shadow.point; }
        \\    shadow.x;
        \\}
    ;
    file := workspace_open(&workspace, "file:///tmp/glolsp-analysis/main.glo", source, 1);
    #assert file >= 0;
    analyze_workspace(&workspace);
    #assert workspace.files[file].syntax.language.diagnostics.count == 0;
    #assert workspace.files[file].semantic.diagnostics.count == 0;
    x := symbol_named(&workspace, file, "x");
    for text: .["child.point.x", "inferred.x", "generic.x", "boxed.value.x", "chosen.x"] {
        offset := find_text(source, text) + text.count - 1;
        #assert analysis_same_symbol(analysis_symbol_at(&workspace, file, offset), x);
    }
    receiver := find_text(source, "#self.x") + 6;
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, file, receiver), x);
    read := symbol_named(&workspace, file, "read");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, file,
        find_text(source, "point.read") + 6), read);
    generic := symbol_named(&workspace, file, "generic");
    generic_type := type_text(&workspace, generic);
    defer generic_type.free();
    #assert generic_type == "Point";
    boxed := symbol_named(&workspace, file, "boxed");
    boxed_type := type_text(&workspace, boxed);
    defer boxed_type.free();
    #assert boxed_type == "Box(Point)";
    container := symbol_named(&workspace, file, "container");
    container_type := type_text(&workspace, container);
    defer container_type.free();
    #assert container_type == "Container(Point)";
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, file,
        find_text(source, "container.value.x") + 16), x);
    length := symbol_named(&workspace, file, "length");
    #assert analysis_type_name(&workspace, analysis_type(&workspace, length)) == "ssize";
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, file,
        find_text(source, "picked.x") + 7), x);
    for needle: .["payload.x", "success.x", "first.x", "second.point.x"] {
        found := analysis_symbol_at(&workspace, file, find_text(source, needle) + needle.count - 1);
        if !analysis_same_symbol(found, x) print("failed member resolution: {}\n", needle);
        #assert analysis_same_symbol(found, x);
    }
    outside := analysis_symbol_at(&workspace, file, find_text(source, "shadow.x"));
    inside := analysis_symbol_at(&workspace, file, find_text(source, "shadow.point"));
    #assert !analysis_same_symbol(outside, inside);
    count := workspace.types.count;
    analyze_workspace(&workspace);
    #assert workspace.types.count == count;

    dependency := #string
        \\#public Item :: struct { value: ssize; }
        \\#public create :: () -> Item { return .{ .value = 1 }; }
        \\secret :: 1;
    ;
    dep := workspace_open(&workspace, "file:///tmp/glolsp-analysis/dep.glo", dependency, 1);
    module := #string
        \\#export "dep.glo";
    ;
    _ := workspace_open(&workspace, "file:///tmp/glolsp-analysis/module.glo", module, 1);
    caller_source := #string
        \\Local :: #load "module.glo";
        \\#load "module.glo";
        \\main :: () {
        \\    item := Local.create();
        \\    item.value;
        \\    create();
        \\    secret;
        \\}
    ;
    caller := workspace_open(&workspace, "file:///tmp/glolsp-analysis/caller.glo",
        caller_source, 1);
    analyze_workspace(&workspace);
    create := symbol_named(&workspace, dep, "create");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, caller,
        find_text(caller_source, "Local.create") + 6), create);
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, caller,
        find_text(caller_source, "    create();") + 4), create);
    value := symbol_named(&workspace, dep, "value");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, caller,
        find_text(caller_source, "item.value") + 5), value);
    #assert analysis_symbol_at(&workspace, caller, find_text(caller_source, "secret;")).symbol < 0;
    invalid_source := #string
        \\Point :: struct { x: ssize; }
        \\take :: (value: bool) {}
        \\main :: () {
        \\    point: Point;
        \\    point.missing;
        \\    unknown;
        \\    value: bool = "wrong";
        \\    value = "wrong";
        \\    take("wrong");
        \\}
    ;
    invalid := workspace_open(&workspace, "file:///tmp/glolsp-analysis/invalid.glo",
        invalid_source, 1);
    analyze_workspace(&workspace);
    #assert workspace.files[invalid].semantic.diagnostics.count == 5;
    fragment_source := #string
        \\#public(unit) shared :: 3;
        \\hidden :: 4;
        \\Embedded ::: #public {
        \\    read :: (#self) -> ssize { return #self.value; }
        \\}
    ;
    fragment := workspace_open(&workspace, "file:///tmp/glolsp-analysis/fragment.glo",
        fragment_source, 1);
    owner_source := #string
        \\#load,embed "fragment.glo";
        \\#public(unit) Embedded :: struct { value: ssize; }
        \\main :: () {
        \\    value: Embedded;
        \\    value.read();
        \\    shared;
        \\    hidden;
        \\}
    ;
    owner := workspace_open(&workspace, "file:///tmp/glolsp-analysis/owner.glo", owner_source, 1);
    analyze_workspace(&workspace);
    shared := symbol_named(&workspace, fragment, "shared");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, owner,
        find_text(owner_source, "    shared;") + 4), shared);
    #assert analysis_symbol_at(&workspace, owner, find_text(owner_source, "hidden;")).symbol < 0;
    method := symbol_named(&workspace, fragment, "read");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, owner,
        find_text(owner_source, "value.read") + 6), method);
    member := symbol_named(&workspace, owner, "value");
    #assert analysis_same_symbol(analysis_symbol_at(&workspace, fragment,
        find_text(fragment_source, "#self.value") + 6), member);
    variadic_invalid := #string
        \\Style :: enum { Native; Unix; }
        \\join :: (parts: ...str, style: Style = .Native) -> str { return ""; }
        \\main :: () {
        \\    join("one", false);
        \\    join("one", .style = "wrong");
        \\}
    ;
    variadic := workspace_open(&workspace, "file:///tmp/glolsp-analysis/variadic.glo",
        variadic_invalid, 1);
    analyze_workspace(&workspace);
    #assert workspace.files[variadic].semantic.diagnostics.count == 2;

    standard: Workspace;
    workspace_init(&standard);
    defer workspace_destroy(&standard);
    standard_source := #string
        \\#import "File_System/File";
        \\#import "Serialization/Json";
        \\#import "Serialization/Core";
        \\main :: () {
        \\    input := File.stdin();
        \\    output := File.stdout();
        \\    errors := File.stderr();
        \\    Serialization_Document.json_document_from_string("{}");
        \\}
    ;
    standard_file := workspace_open(&standard, "file:///tmp/glolsp-analysis/standard.glo",
        standard_source, 1);
    analyze_workspace(&standard);
    #assert standard.files[standard_file].semantic.diagnostics.count == 0;
    for name: .["stdin", "stdout", "stderr", "json_document_from_string"] {
        id := analysis_symbol_at(&standard, standard_file, find_text(standard_source, name));
        #assert id.symbol >= 0;
        #assert standard.files[id.file].syntax.symbols[id.symbol].name == name;
    }
    print("workspace semantic analysis passed\n");
}
